{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helia-core-tester.local/generation/descriptors/schema.json",
  "title": "Helia-Core Tester Descriptor Schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "operator"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "operator": {
      "type": "string",
      "enum": [
        "Abs",
        "Add",
        "ArgMax",
        "ArgMin",
        "AvgPool",
        "BatchNorm",
        "BatchMatMul",
        "BatchToSpaceND",
        "BroadcastTo",
        "ChunkedEquivalence",
        "Clamp",
        "Comparison",
        "Concatenation",
        "Convolve",
        "DepthToSpace",
        "DepthwiseConv",
        "Dequantize",
        "DynamicUpdateSlice",
        "Fill",
        "FullyConnected",
        "Gather",
        "GatherND",
        "HardSwishCompat",
        "HardSwishPrecise",
        "LSTMUnidirectional",
        "LeakyRelu",
        "Logistic",
        "MaxPool",
        "Maximum",
        "Mean",
        "Minimum",
        "MirrorPad",
        "Mul",
        "NNActivationFloat",
        "NNActivationS16",
        "PReLU",
        "PReLUScalar",
        "Pad",
        "Quantize",
        "ReduceMax",
        "ReduceMin",
        "Relu",
        "Relu6",
        "Requantize",
        "Reshape",
        "ResizeNearestNeighbor",
        "ReverseSequence",
        "Rsqrt",
        "SVDF",
        "ScatterNd",
        "SelectV2",
        "Softmax",
        "SpaceToBatchND",
        "SpaceToDepth",
        "Split",
        "Sqrt",
        "SquaredDifference",
        "Squeeze",
        "StridedSlice",
        "Sub",
        "Tanh",
        "Tile",
        "Transpose",
        "TransposeConv",
        "VariableUpdate",
        "Where"
      ]
    },
    "activation_dtype": {
      "type": "string",
      "enum": [
        "S8",
        "S16",
        "S32"
      ]
    },
    "weight_dtype": {
      "type": "string",
      "enum": [
        "S4",
        "S8"
      ]
    },
    "tensor_dtypes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "input": {
          "$ref": "#/$defs/tensorDType"
        },
        "output": {
          "$ref": "#/$defs/tensorDType"
        },
        "weights": {
          "$ref": "#/$defs/tensorDType"
        },
        "bias": {
          "$ref": "#/$defs/tensorDType"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atol": {
          "type": "number"
        },
        "rtol": {
          "type": "number"
        },
        "tolerance": {
          "type": "integer"
        }
      }
    },
    "activation": {
      "type": "string",
      "enum": [
        "NONE",
        "RELU",
        "RELU6"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "equal",
        "not_equal",
        "greater",
        "greater_equal",
        "less",
        "less_equal"
      ]
    },
    "padding": {
      "type": "string",
      "enum": [
        "SAME",
        "VALID",
        "same",
        "valid"
      ]
    },
    "name_hint": {
      "type": "string"
    },
    "input_shape": {
      "$ref": "#/$defs/intArray"
    },
    "input_mode": {
      "description": "Input generation mode. 'uniform' draws from input_min/input_max. 'nonfinite_sweep' additionally overwrites the leading elements with the tokens named by nonfinite_tokens, leaving the remaining draws finite; float suite only.",
      "type": "string",
      "enum": ["uniform", "nonfinite_sweep"]
    },
    "nonfinite_tokens": {
      "description": "Tokens written by 'nonfinite_sweep', in order, one per leading flat element. Defaults to all three. Name a subset where ns-cmsis-nn does not guarantee the omitted token's behaviour.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["nan", "inf", "-inf"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "filter_shape": {
      "$ref": "#/$defs/intArray"
    },
    "input_1_shape": {
      "$ref": "#/$defs/intArray"
    },
    "input_2_shape": {
      "$ref": "#/$defs/intArray"
    },
    "pool_size": {
      "$ref": "#/$defs/intArray"
    },
    "indices_shape": {
      "$ref": "#/$defs/intArray"
    },
    "size": {
      "$ref": "#/$defs/intArray"
    },
    "target_shape": {
      "$ref": "#/$defs/intArray"
    },
    "strides": {
      "$ref": "#/$defs/intArray"
    },
    "begin": {
      "$ref": "#/$defs/intArray"
    },
    "end": {
      "$ref": "#/$defs/intArray"
    },
    "block_size": {
      "$ref": "#/$defs/intArray"
    },
    "block_shape": {
      "$ref": "#/$defs/intArray"
    },
    "crops": {
      "$ref": "#/$defs/intArray"
    },
    "pads": {
      "$ref": "#/$defs/intArray"
    },
    "use_bias": {
      "type": "boolean"
    },
    "axis": {
      "type": "integer"
    },
    "value": {
      "type": [
        "integer",
        "number"
      ]
    },
    "act_min": {
      "type": ["integer", "number"]
    },
    "act_max": {
      "type": ["integer", "number"]
    },
    "activation_type": {
      "type": "string"
    },
    "layout": {
      "type": "string",
      "enum": [
        "ARM_NN_LAYOUT_NHWC"
      ]
    },
    "dataset": {
      "type": "string"
    },
    "batch_size": {
      "type": "integer"
    },
    "time_steps": {
      "type": "integer"
    },
    "feature_size": {
      "type": "integer"
    },
    "units": {
      "type": "integer"
    },
    "time_major": {
      "type": "boolean"
    },
    "force_shared_scale": {
      "type": "boolean"
    },
    "shared_fq_range": {
      "$ref": "#/$defs/numberArray"
    },
    "rep_samples": {
      "type": "integer"
    },
    "effective_scale_multiplier": {
      "type": "integer"
    },
    "effective_scale_shift": {
      "type": "integer"
    },
    "input_zeropoint": {
      "type": "integer"
    },
    "output_zeropoint": {
      "type": "integer"
    },
    "hint": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "call_style": {
          "type": "string"
        },
        "force_cmsis": {
          "type": "boolean"
        },
        "kernel": {
          "type": "string"
        },
        "extras": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "input_zero_point": {
              "type": "integer"
            },
            "output_zero_point": {
              "type": "integer"
            },
            "input_scale": {
              "type": "number"
            },
            "weight_scale": {
              "type": "number"
            },
            "output_scale": {
              "type": "number"
            }
          }
        }
      }
    },
    "kernel": {
      "type": "string",
      "enum": ["add", "sub", "mul"],
      "description": "ChunkedEquivalence: elementwise kernel family to exercise."
    },
    "element_count": {
      "type": "integer",
      "minimum": 1,
      "description": "ChunkedEquivalence: total number of elements for the full-length reference call."
    },
    "chunk_sizes": {
      "$ref": "#/$defs/intArray",
      "description": "ChunkedEquivalence: consecutive slice sizes for the chunked pass; must sum to element_count."
    }
  },
  "$defs": {
    "tensorDType": {
      "type": "string",
      "enum": [
        "FP32",
        "FP16",
        "S8",
        "S16",
        "S32",
        "S4",
        "BOOL"
      ]
    },
    "intArray": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "numberArray": {
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  },
  "allOf": [
    {
      "$comment": "descriptor_dtype_fields",
      "anyOf": [
        {
          "required": [
            "activation_dtype",
            "weight_dtype"
          ]
        },
        {
          "required": [
            "tensor_dtypes"
          ]
        }
      ]
    },
    {
      "$comment": "descriptor_profile:fully_connected",
      "if": {
        "properties": {
          "operator": {
            "const": "FullyConnected"
          }
        }
      },
      "then": {
        "required": [
          "input_shape",
          "filter_shape"
        ]
      }
    },
    {
      "$comment": "descriptor_profile:conv",
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "Convolve",
              "DepthwiseConv"
            ]
          }
        }
      },
      "then": {
        "required": [
          "input_shape",
          "filter_shape"
        ]
      }
    },
    {
      "$comment": "descriptor_profile:dual_input_elementwise",
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "Add",
              "BatchMatMul",
              "Comparison",
              "Maximum",
              "Minimum",
              "Mul",
              "SelectV2",
              "SquaredDifference",
              "Sub"
            ]
          }
        }
      },
      "then": {
        "required": [
          "input_1_shape",
          "input_2_shape"
        ]
      }
    },
    {
      "$comment": "operator_required_fields:Comparison",
      "if": {
        "properties": {
          "operator": {
            "const": "Comparison"
          }
        }
      },
      "then": {
        "required": [
          "operation"
        ]
      }
    },
    {
      "$comment": "descriptor_profile:pool",
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "AvgPool",
              "MaxPool"
            ]
          }
        }
      },
      "then": {
        "required": [
          "input_shape"
        ],
        "anyOf": [
          {
            "required": [
              "pool_size"
            ]
          },
          {
            "required": [
              "filter_shape"
            ]
          }
        ]
      }
    },
    {
      "$comment": "descriptor_profile:single_input_unary",
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "Relu",
              "Relu6",
              "LeakyRelu",
              "Softmax",
              "Quantize",
              "Dequantize",
              "Abs",
              "Transpose",
              "StridedSlice",
              "Pad",
              "LSTMUnidirectional",
              "SVDF",
              "Mean",
              "ReduceMax",
              "ReduceMin",
              "ArgMax",
              "ArgMin",
              "Rsqrt",
              "Sqrt",
              "TransposeConv",
              "Tanh",
              "Logistic",
              "HardSwishPrecise",
              "HardSwishCompat",
              "PReLU",
              "PReLUScalar",
              "Fill",
              "Reshape",
              "Squeeze",
              "SpaceToDepth",
              "DepthToSpace",
              "Split",
              "Concatenation",
              "SpaceToBatchND",
              "BatchToSpaceND",
              "ResizeNearestNeighbor",
              "VariableUpdate",
              "Clamp",
              "NNActivationS16",
              "Gather",
              "GatherND",
              "Requantize"
            ]
          }
        }
      },
      "then": {
        "required": [
          "input_shape"
        ]
      }
    },
    {
      "$comment": "operator_required_fields:Clamp",
      "if": {
        "properties": {
          "operator": {
            "const": "Clamp"
          }
        }
      },
      "then": {
        "required": [
          "act_min",
          "act_max"
        ]
      }
    },
    {
      "$comment": "operator_required_fields:NNActivationS16",
      "if": {
        "properties": {
          "operator": {
            "const": "NNActivationS16"
          }
        }
      },
      "then": {
        "required": [
          "activation_type"
        ]
      }
    },
    {
      "$comment": "operator_required_fields:Gather",
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "Gather",
              "GatherND"
            ]
          }
        }
      },
      "then": {
        "required": [
          "indices_shape"
        ]
      }
    },
    {
      "$comment": "operator_required_fields:PReLUScalar",
      "if": {
        "properties": {
          "operator": {
            "const": "PReLUScalar"
          }
        }
      },
      "then": {
        "required": [
          "alpha_shape",
          "scalar_input_value"
        ]
      }
    },
    {
      "$comment": "operator_required_fields:Requantize",
      "if": {
        "properties": {
          "operator": {
            "const": "Requantize"
          }
        }
      },
      "then": {
        "required": [
          "effective_scale_multiplier",
          "effective_scale_shift",
          "input_zeropoint",
          "output_zeropoint"
        ]
      }
    },
    {
      "$comment": "operator_required_fields:ResizeNearestNeighbor",
      "if": {
        "properties": {
          "operator": {
            "const": "ResizeNearestNeighbor"
          }
        }
      },
      "then": {
        "required": [
          "size"
        ]
      }
    },
    {
      "$comment": "operator_activation_dtype_const:HardSwishCompat",
      "if": {
        "properties": {
          "operator": {
            "const": "HardSwishCompat"
          }
        }
      },
      "then": {
        "properties": {
          "activation_dtype": {
            "const": "S8"
          }
        }
      }
    },
    {
      "$comment": "descriptor_profile:shape_transform",
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "BroadcastTo",
              "ReverseSequence",
              "Tile"
            ]
          }
        }
      },
      "then": {
        "required": [
          "input_shape"
        ]
      }
    },
    {
      "$comment": "BroadcastTo requires output_shape",
      "if": { "properties": { "operator": { "const": "BroadcastTo" } } },
      "then": { "required": ["output_shape"] }
    },
    {
      "$comment": "ChunkedEquivalence requires kernel, element_count and chunk_sizes",
      "if": { "properties": { "operator": { "const": "ChunkedEquivalence" } } },
      "then": { "required": ["kernel", "element_count", "chunk_sizes"] }
    },
    {
      "$comment": "Tile requires multiples",
      "if": { "properties": { "operator": { "const": "Tile" } } },
      "then": { "required": ["multiples"] }
    },
    {
      "$comment": "ReverseSequence requires seq_lengths, seq_dim, batch_dim",
      "if": { "properties": { "operator": { "const": "ReverseSequence" } } },
      "then": { "required": ["seq_lengths", "seq_dim", "batch_dim"] }
    },
    {
      "$comment": "MirrorPad requires paddings",
      "if": { "properties": { "operator": { "const": "MirrorPad" } } },
      "then": { "required": ["input_shape", "paddings"] }
    },
    {
      "$comment": "ScatterNd requires indices, updates",
      "if": { "properties": { "operator": { "const": "ScatterNd" } } },
      "then": { "required": ["input_shape", "indices", "updates"] }
    },
    {
      "$comment": "DynamicUpdateSlice requires operand_shape, update_shape, start_indices",
      "if": { "properties": { "operator": { "const": "DynamicUpdateSlice" } } },
      "then": { "required": ["operand_shape", "update_shape", "start_indices"] }
    }
  ]
}
