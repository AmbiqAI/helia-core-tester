{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hct/library-profile/1",
  "title": "hct library profile (hct-library.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "library"
  ],
  "properties": {
    "schema": {
      "const": "hct/library-profile/1"
    },
    "library": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "The library's id."
    },
    "source_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\x00]+$",
      "description": "The library checkout, relative to the profile's directory; default \".\"."
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signatures"
      ],
      "description": "The library's kernel contract documents, relative to the profile's directory and inside source_root.",
      "properties": {
        "signatures": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "The signature export (hct/kernel-contracts/1).",
          "pattern": "^[^\\x00]+$"
        },
        "implementations": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "The implementation manifest (hct/kernel-implementations/1), when the library has one.",
          "pattern": "^[^\\x00]+$"
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes",
        "header_includes",
        "status"
      ],
      "description": "What a generated harness needs from the library; an ns-cmsis-nn profile without it takes ns-cmsis-nn's.",
      "properties": {
        "includes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/header"
          },
          "description": "Headers every generated test and the test runtime include (through hct_library.h)."
        },
        "header_includes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/header"
          },
          "description": "Headers each case's harness header includes."
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "success",
            "argument_error",
            "codes"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/identifier",
              "description": "The kernels' status type."
            },
            "success": {
              "$ref": "#/$defs/identifier",
              "description": "The code a kernel returns when it succeeds."
            },
            "argument_error": {
              "$ref": "#/$defs/identifier",
              "description": "The code for rejected arguments; the harness returns it when a scratch query fails."
            },
            "not_implemented": {
              "$ref": "#/$defs/identifier",
              "description": "The code an entry returns when it declines on the build, when the library has one."
            },
            "codes": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 256,
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "maxLength": 128
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "description": "Every status code by name and value; hct_library.h asserts each against the headers."
            }
          }
        },
        "context": {
          "$ref": "#/$defs/identifier",
          "description": "The scratch context type, when the kernels take one."
        },
        "dims": {
          "$ref": "#/$defs/identifier",
          "description": "The tensor shape type, when the library has one."
        },
        "alias_groups": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "description": "Group name: spellings of one parameter; a harness value binds to any of them."
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "maxLength": 128
    },
    "header": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_+.-]*(/[A-Za-z0-9_][A-Za-z0-9_+.-]*)*\\.h$",
      "maxLength": 256
    }
  }
}
