#include "{{ name }}_max_pool.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

{% if requires_kernel_prototype | default(false) %}
arm_cmsis_nn_status {{ kernel_fn }}(const cmsis_nn_context *ctx,
                                    const {{ pool_params_type }} *pool_params,
                                    const cmsis_nn_dims *input_dims,
                                    const {{ input_dtype }} *src,
                                    const cmsis_nn_dims *filter_dims,
                                    const cmsis_nn_dims *output_dims,
                                    {{ output_dtype }} *dst);

{% endif %}
{# Declare only the buffers this fault mode actually passes to the kernel so a
   NULL-substituted buffer never becomes an unused static (-Wunused-variable). #}
{% if fault != "null_output" %}{{ helia_guard_declare(output_dtype, name ~ "_output", output_dims.n * output_dims.h * output_dims.w * output_dims.c) }}
{% endif %}{% if buffer_size_max > 0 %}{{ helia_guard_declare("uint8_t", name ~ "_buffer", buffer_size_max) }}
{% endif %}

/*
 * Fault-injection test case: exercises an {{ kernel_fn }}
 * argument-validation branch. Fault mode: {{ fault }}.
 */
static int32_t run_max_pool(void)
{
    const cmsis_nn_context ctx = {
{% if buffer_size_max > 0 %}
        .buf = {{ name }}_buffer,
        .size = sizeof({{ name }}_buffer),
{% else %}
        .buf = NULL,
        .size = 0,
{% endif %}
    };
    cmsis_nn_dims input_dims = {{ name }}_input_dims;
{% if fault == "zero_dim" %}
    input_dims.n = 0;
{% elif fault == "negative_dim" %}
    input_dims.n = -1;
{% endif %}
    const {{ input_dtype }} *input_arg = {% if fault == "null_input" %}NULL{% else %}{{ name }}_input{% endif %};
    {{ output_dtype }} *output_arg = {% if fault == "null_output" %}NULL{% else %}{{ name }}_output{% endif %};

    return {{ kernel_fn }}(
        &ctx,
        &{{ name }}_pool_params,
        &input_dims,
        input_arg,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims,
        output_arg
    );
}

int32_t {{ name }}_test_case_run(void)
{
{% if fault != "null_output" %}    HELIA_GUARD_ARM({{ name }}_output, true /* rejected call must not write it: poison */);
{% endif %}{% if buffer_size_max > 0 %}    HELIA_GUARD_ARM({{ name }}_buffer, true /* pure scratch: poison-safe */);
{% endif %}    int32_t status = run_max_pool();
    int failures = 0;
{% if fault != "null_output" %}    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("Pooling") }} output", failures);
{% if expected_status != "ARM_CMSIS_NN_SUCCESS" %}    HELIA_GUARD_CHECK_UNTOUCHED({{ name }}_output, "{{ validation_label | default("Pooling") }} output", failures);
{% endif %}{% endif %}{% if buffer_size_max > 0 %}    HELIA_GUARD_CHECK({{ name }}_buffer, "{{ validation_label | default("Pooling") }} buffer", failures);
{% endif %}    HELIA_VALIDATE_EXPECTED_STATUS(
        "{{ validation_label | default("Pooling") }}",
        status,
        {{ expected_status }}
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
