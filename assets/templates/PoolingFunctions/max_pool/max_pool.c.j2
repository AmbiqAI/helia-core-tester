#include "{{ name }}_max_pool.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/validation.j2" import validation_outputs with context %}

{% if requires_kernel_prototype | default(false) %}
arm_cmsis_nn_status {{ kernel_fn }}(const cmsis_nn_context *ctx,
                                    const {{ pool_params_type }} *pool_params,
                                    const cmsis_nn_dims *input_dims,
                                    const {{ input_dtype }} *src,
                                    const cmsis_nn_dims *filter_dims,
                                    const cmsis_nn_dims *output_dims,
                                    {{ output_dtype }} *dst);

{% endif %}
// Context for buffer allocation
static cmsis_nn_context {{ name }}_ctx;

// Runtime scratch buffer (max upper bound; actual size queried at runtime)
// Buffer size: 0 for max pooling, input_channels * 4 for average pooling (DSP)
#define {{ name|upper }}_BUFFER_SIZE_MAX {{ buffer_size_max }}
{% if buffer_size_max > 0 %}
static uint8_t {{ name }}_buffer[{{ name|upper }}_BUFFER_SIZE_MAX];
{% else %}
// No buffer needed for max pooling
static uint8_t* {{ name }}_buffer = NULL;
{% endif %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
static {{ output_dtype }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];

int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    {% if kernel_get_buffer_size_fn %}
    // Calculate required buffer size (for average pooling)
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        {{ name }}_output_dims.w,  // output width
        {{ name }}_input_dims.c     // input channels
    );

{% if expected_buffer_size is defined and expected_buffer_size is not none %}
    // Exact scratch size (issue #69): asserted against a value measured independently
    // from calculate_pooling_buffer_size_max's static-allocation upper bound -- see
    // {{ kernel_get_buffer_size_fn }}() in the ns-cmsis-nn checkout. Unreachable today:
    // no MaxPool kernel_info entry ever sets kernel_get_buffer_size_fn (CMSIS-NN has no
    // arm_max_pool*_get_buffer_size function), so this branch is dead code kept only
    // for parity with avg_pool.c.j2 in case that ever changes.
    {% if expected_buffer_size is mapping %}
#if defined(ARM_MATH_MVEI)
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Pooling") }}", "buffer size", {{ expected_buffer_size.mve }}, required_buffer_size);
#elif defined(ARM_MATH_DSP)
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Pooling") }}", "buffer size", {{ expected_buffer_size.dsp }}, required_buffer_size);
#else
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Pooling") }}", "buffer size", {{ expected_buffer_size.generic }}, required_buffer_size);
#endif
    {% else %}
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Pooling") }}", "buffer size", {{ expected_buffer_size }}, required_buffer_size);
    {% endif %}
{% endif %}

    if (required_buffer_size > {{ name|upper }}_BUFFER_SIZE_MAX) {
        printf("Buffer size error: required=%d > max=%d\r\n", required_buffer_size, {{ name|upper }}_BUFFER_SIZE_MAX);
        return ARM_CMSIS_NN_ARG_ERROR;
    }

    // Initialize context buffer
    {{ name }}_ctx.buf = {{ name }}_buffer;
    {{ name }}_ctx.size = required_buffer_size;
    {% else %}
    // Max pooling doesn't need a buffer
    {{ name }}_ctx.buf = NULL;
    {{ name }}_ctx.size = 0;
    {% endif %}

    // Call pooling kernel
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_ctx,
        &{{ name }}_pool_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims,
        output
    );
    
    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
    int32_t status = {{ name }}_run({{ name }}_input, {{ name }}_output);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Pooling") }}", status);

    int failures = 0;
{{ validation_outputs(validation_mode_token | default("TOLERANT_INT"), validation_tolerance | default(1)) }}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
