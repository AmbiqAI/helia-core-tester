#include "{{ name }}_avg_pool.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}
{% from "common/standalone/validation.j2" import validation_outputs with context %}

{% if requires_kernel_prototype | default(false) %}
arm_cmsis_nn_status {{ kernel_fn }}(const cmsis_nn_context *ctx,
                                    const {{ pool_params_type }} *pool_params,
                                    const cmsis_nn_dims *input_dims,
                                    const {{ input_dtype }} *src,
                                    const cmsis_nn_dims *filter_dims,
                                    const cmsis_nn_dims *output_dims,
                                    {{ output_dtype }} *dst);

{% endif %}
// Context for buffer allocation
static cmsis_nn_context {{ name }}_ctx;

// Runtime scratch buffer (max upper bound; actual size queried at runtime)
// Buffer size: 0 for max pooling, input_channels * 4 for average pooling (DSP)
#define {{ name|upper }}_BUFFER_SIZE_MAX {{ buffer_size_max }}
{% if buffer_size_max > 0 %}
{{ helia_guard_declare("uint8_t", name ~ "_buffer", name|upper ~ "_BUFFER_SIZE_MAX") }}
{% else %}
// No buffer needed for max pooling
static uint8_t* {{ name }}_buffer = NULL;
{% endif %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
{{ helia_guard_declare(output_dtype, name ~ "_output", name|upper ~ "_OUTPUT_SIZE") }}

int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    {% if buffer_size_max > 0 %}
    // Armed unconditionally: declared/checked whenever buffer_size_max > 0
    // (see the DSP buffer-size comment above), even for kernel variants
    // (e.g. the float kernels below) that never query a buffer size and
    // leave ctx.buf NULL -- poisoning an unused buffer here is harmless,
    // and keeps this in lockstep with the CHECK in _test_case_run instead
    // of leaving its canary unstamped whenever kernel_get_buffer_size_fn
    // is absent.
    HELIA_GUARD_ARM({{ name }}_buffer, true /* pure scratch: poison to catch read-before-write */);
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, 0u);
    // Stamped as wholly unused here, and re-stamped with the real size once the context is
    // populated. It matters in the renderings that call a sizer: an early return from the
    // checks below would otherwise leave this canary poisoned, and the unconditional check
    // in _test_case_run would read that poison and report a fabricated overrun, which the
    // report parser classifies ahead of the sizer failure that actually occurred (#68).
    // In the rendering with no sizer there is no early return and this pre-stamp is
    // redundant, overwritten two statements later; it is emitted unconditionally to keep
    // this in lockstep with the arm above rather than to guard anything there.
    {% endif %}
    {% if kernel_get_buffer_size_fn %}
    // Calculate required buffer size (for average pooling)
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        {{ name }}_output_dims.w,  // output width
        {{ name }}_input_dims.c     // input channels
    );

    // The sizer's answer is checked before it becomes a context size (#133). A negative
    // answer is the documented out-of-range sentinel and never a usable size; an answer
    // above this case's static means our generation-time bound and the shipped kernel
    // disagree. They are separate failures because they have separate owners.
    HELIA_VALIDATE_SIZER("{{ kernel_get_buffer_size_fn }}", required_buffer_size);
    HELIA_VALIDATE_SIZER_FITS("{{ kernel_get_buffer_size_fn }}", required_buffer_size, {{ name|upper }}_BUFFER_SIZE_MAX);

    // Initialize context buffer
    {{ name }}_ctx.buf = {{ name }}_buffer;
    {{ name }}_ctx.size = required_buffer_size;
    {% else %}
    // Max pooling doesn't need a buffer
    {{ name }}_ctx.buf = NULL;
    {{ name }}_ctx.size = 0;
    {% endif %}
    {% if buffer_size_max > 0 %}
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u);
    {% endif %}

    // Call pooling kernel
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_ctx,
        &{{ name }}_pool_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims,
        output
    );
    
    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    int32_t status = {{ name }}_run({{ name }}_input, {{ name }}_output);
    int failures = 0;
    {% if buffer_size_max > 0 %}
    HELIA_GUARD_CHECK({{ name }}_buffer, "{{ validation_label | default("Pooling") }} scratch", failures);
    HELIA_GUARD_CHECK_SLACK({{ name }}_buffer, "{{ validation_label | default("Pooling") }} scratch slack", {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u, failures);
    {% endif %}
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("Pooling") }} output", failures);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Pooling") }}", status);

{{ validation_outputs(validation_mode_token | default("TOLERANT_INT"), validation_tolerance | default(1)) }}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
