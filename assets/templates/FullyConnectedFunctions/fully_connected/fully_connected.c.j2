#include "{{ name }}_fully_connected.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}
{% from "common/standalone/validation.j2" import validation_outputs, declinable_status_checks with context %}

{% set packed = entry_family == "fully_connected_packed_s8" %}
// Context for buffer allocation
static cmsis_nn_context {{ name }}_ctx;

{% if packed %}
#include "arm_nnsupportfunctions.h"

// The entry takes no scratch. The buffer holds the weight stream {{ kernel_fn }}_pack()
// builds once before the call, as an ahead-of-time caller does (max upper bound in bytes;
// actual size queried at runtime). Word storage keeps it 4-byte aligned, as the entry requires.
#define {{ name|upper }}_BUFFER_SIZE_MAX {{ buffer_size_max }}
{{ helia_guard_declare("int32_t", name ~ "_buffer", name|upper ~ "_BUFFER_SIZE_MAX / 4") }}
{{ helia_guard_declare("int32_t", name ~ "_kernel_sum", filter_dims.c) }}
{% else %}
// Runtime scratch buffer (max upper bound; actual size queried at runtime)
// Buffer size calculated conservatively to handle MVE and DSP implementations
#define {{ name|upper }}_BUFFER_SIZE_MAX {{ buffer_size_max }}
{{ helia_guard_declare("uint8_t", name ~ "_buffer", name|upper ~ "_BUFFER_SIZE_MAX") }}
{% endif %}


#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
{{ helia_guard_declare(output_dtype, name ~ "_output", name|upper ~ "_OUTPUT_SIZE") }}

{% if packed %}
int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    return {{ kernel_fn }}(
        &{{ name }}_fc_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        (const int8_t *){{ name }}_buffer,
        &{{ name }}_output_dims,
        output
    );
}
{% else %}
int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    // Calculate required buffer size. Each arm records the sizer it actually calls in
    // sizer_fn, because the checks below name it in their failure line: reporting
    // the dispatch-level name here would attribute a per-channel sizer's answer to the
    // per-tensor one, which is the misattribution #133 exists to remove. The four-bit arm
    // records nothing, since it calls no sizer at all.
    {% if float_kernel %}
    {% set sizer_fn = kernel_get_buffer_size_fn %}
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        &{{ name }}_fc_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims,
        {{ kernel_layout }}
    );
    {% elif kernel_fn == 'arm_fully_connected_s4' %}
    {% set sizer_fn = none %}
    // No declaration here. This arm calls no sizer, and its context arm below sets a null
    // buffer and a zero size without consulting one, so the variable the other arms declare
    // would be unread. Before #133 the capacity comparison read it unconditionally, which is
    // what kept it live; now that the checks are gated on a sizer actually having been
    // called, declaring it here is an unused variable and -Wunused-variable is on.
    {% elif quant_params.per_channel and output_dtype == 'int16_t' %}
    {% set sizer_fn = 'arm_fully_connected_per_channel_s16_get_buffer_size' %}
    // For per-channel S16, use per_channel buffer size function
    int32_t required_buffer_size = arm_fully_connected_per_channel_s16_get_buffer_size(
        &{{ name }}_filter_dims
    );
    {% else %}
    {% set sizer_fn = kernel_get_buffer_size_fn %}
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        &{{ name }}_filter_dims
    );
    {% endif %}
    // Armed before the capacity check below: an early return there would otherwise leave
    // these canaries unstamped, and the unconditional check in _test_case_run would
    // report a fabricated breach instead of the real sizer error (#68).
    HELIA_GUARD_ARM({{ name }}_buffer, true /* pure scratch: poison to catch read-before-write */);
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, 0u);
    // The slack is stamped as wholly unused here so that an early return from the
    // capacity check below leaves every canary in a checked state; it is re-stamped
    // with the real size once the context is populated (#68).


    // The sizer's answer is checked before it becomes a context size (#133). A negative
    // answer is the documented out-of-range sentinel and never a usable size; an answer
    // above this case's static means our generation-time bound and the shipped kernel
    // disagree. They are separate failures because they have separate owners.
    {% if sizer_fn %}
    HELIA_VALIDATE_SIZER("{{ sizer_fn }}", required_buffer_size);
    HELIA_VALIDATE_SIZER_FITS("{{ sizer_fn }}", required_buffer_size, {{ name|upper }}_BUFFER_SIZE_MAX);
    {% endif %}

    // Armed unconditionally: {{ name }}_buffer is only ctx.buf in some branches
    // below (s4 uses NULL, weight_sum variants point ctx.buf elsewhere), but
    // poisoning/guarding it here regardless is harmless and keeps the check
    // in _test_case_run unconditional too.

    // Initialize context buffer
    {% if float_kernel %}
    {{ name }}_ctx.buf = {{ name }}_buffer;
    {{ name }}_ctx.size = required_buffer_size;
    {% elif kernel_fn == 'arm_fully_connected_s4' %}
    {{ name }}_ctx.buf = NULL;
    {{ name }}_ctx.size = 0;
    {% elif has_weight_sum %}
    // For S8 fully connected with weight_sum, the ctx buffer should point to precomputed weight_sum
    // Weight sum is precomputed at code generation time and embedded in header
    // ctx.size must be in bytes: filter_dims.c * sizeof(int32_t)
    {{ name }}_ctx.buf = (uint8_t *){{ name }}_weight_sum;
    {{ name }}_ctx.size = {{ filter_dims.c }} * 4;  // sizeof(int32_t) = 4
    {% else %}
    {{ name }}_ctx.buf = {{ name }}_buffer;
    {{ name }}_ctx.size = required_buffer_size;
    {% endif %}
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u);

    // Call fully connected kernel via wrapper (handles per-channel/per-tensor)
    {% if float_kernel %}
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_ctx,
        &{{ name }}_fc_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        {{ name }}_weights,
        &{{ name }}_bias_dims,
        {% if has_biases %}
        {{ name }}_biases,
        {% else %}
        NULL,
        {% endif %}
        &{{ name }}_output_dims,
        output{% if kernel_needs_layout is not defined or kernel_needs_layout %},
        {{ kernel_layout }}
        {% endif %}
    );
    {% elif kernel_fn == 'arm_fully_connected_s4' %}
    arm_cmsis_nn_status kernel_status = arm_fully_connected_s4(
        &{{ name }}_ctx,
        &{{ name }}_fc_params,
        &{{ name }}_quant_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        {{ name }}_weights,
        &{{ name }}_bias_dims,
        {% if has_biases %}
        {{ name }}_biases,
        {% else %}
        NULL,
        {% endif %}
        &{{ name }}_output_dims,
        output
    );
    {% else %}
    cmsis_nn_quant_params quant_params_wrapper = {
        {% if quant_params.per_channel %}
        .multiplier = (int32_t*){{ name }}_multiplier,
        .shift = (int32_t*){{ name }}_shift,
        .is_per_channel = 1
        {% else %}
        .multiplier = (int32_t*)&{{ name }}_multiplier_val,
        .shift = (int32_t*)&{{ name }}_shift_val,
        .is_per_channel = 0
        {% endif %}
    };
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_ctx,
        &{{ name }}_fc_params,
        &quant_params_wrapper,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        {{ name }}_weights,
        &{{ name }}_bias_dims,
        {% if has_biases %}
        {{ name }}_biases,
        {% else %}
        NULL,
        {% endif %}
        &{{ name }}_output_dims,
        output
    );
    {% endif %}
    
    return kernel_status;
}
{% endif %}

int32_t {{ name }}_test_case_run(void)
{
    {% if packed %}
    int failures = 0;
    // The stream is built the way the entry's caller must build it: the gate first, then kernel
    // sums with the input offset and bias folded in (filter offset 0), then the entry's packer.
    HELIA_VALIDATE_SCALAR_EQ_INT(
        "{{ validation_label | default("Fully connected") }}",
        "arm_nn_fc_packed_s8_supported",
        {{ 1 if expected_status == "ARM_CMSIS_NN_SUCCESS" else 0 }},
        arm_nn_fc_packed_s8_supported(&{{ name }}_fc_params, &{{ name }}_quant_params, &{{ name }}_filter_dims)
    );
    const int32_t packed_size = {{ kernel_get_buffer_size_fn }}(&{{ name }}_filter_dims);
    HELIA_VALIDATE_SIZER("{{ kernel_get_buffer_size_fn }}", packed_size);
    HELIA_VALIDATE_SIZER_FITS("{{ kernel_get_buffer_size_fn }}", packed_size, {{ name|upper }}_BUFFER_SIZE_MAX);
    {{ name }}_ctx.buf = (uint8_t *){{ name }}_buffer;
    {{ name }}_ctx.size = packed_size;
    HELIA_GUARD_ARM({{ name }}_kernel_sum, true /* written only by arm_vector_sum_s8: poison */);
    HELIA_GUARD_ARM({{ name }}_buffer, true /* written only by the packer: poison */);
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, (size_t)packed_size);
    arm_cmsis_nn_status pack_status = arm_vector_sum_s8(
        {{ name }}_kernel_sum,
        {{ filter_dims.n }},
        {{ filter_dims.c }},
        {{ name }}_weights,
        {{ name }}_fc_params.input_offset,
        0,
        {{ name }}_biases
    );
    if (pack_status == ARM_CMSIS_NN_SUCCESS) {
        pack_status = {{ kernel_fn }}_pack(
            &{{ name }}_filter_dims,
            {{ name }}_weights,
            {{ name }}_kernel_sum,
            &{{ name }}_quant_params,
            (int8_t *){{ name }}_buffer
        );
    }
    HELIA_GUARD_CHECK({{ name }}_kernel_sum, "{{ validation_label | default("Fully connected") }} kernel sums", failures);
    HELIA_GUARD_CHECK({{ name }}_buffer, "{{ validation_label | default("Fully connected") }} packed weights", failures);
    HELIA_GUARD_CHECK_SLACK({{ name }}_buffer, "{{ validation_label | default("Fully connected") }} packed weights slack", (size_t)packed_size, failures);
    HELIA_VALIDATE_STATUS("{{ kernel_fn }}_pack", pack_status);
    {% endif %}
    {% if autovectorize_declines %}
#if defined(HELIA_CMSIS_NN_INT_AUTOVECTORIZE)
    HELIA_GUARD_ARM({{ name }}_output, true /* the entry declines on this build: poison */);
#else
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
#endif
    {% elif expected_status | default("ARM_CMSIS_NN_SUCCESS") != "ARM_CMSIS_NN_SUCCESS" %}
    HELIA_GUARD_ARM({{ name }}_output, true /* a declined call must not write it: poison */);
    {% else %}
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    {% endif %}
    int32_t status = {{ name }}_run({{ name }}_input, {{ name }}_output);
    {% if not packed %}
    int failures = 0;
    {% endif %}
    HELIA_GUARD_CHECK({{ name }}_buffer, "{{ validation_label | default("Fully connected") }} {{ "packed weights" if packed else "scratch" }}", failures);
    HELIA_GUARD_CHECK_SLACK({{ name }}_buffer, "{{ validation_label | default("Fully connected") }} {{ "packed weights" if packed else "scratch" }} slack", {{ name }}_ctx.buf == {{ "(uint8_t *)" if packed }}{{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u, failures);
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("Fully connected") }} output", failures);
{{ declinable_status_checks(validation_label | default("Fully connected")) }}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
