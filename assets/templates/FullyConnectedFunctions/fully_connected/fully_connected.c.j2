#include "{{ name }}_fully_connected.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}
{% from "common/standalone/validation.j2" import validation_outputs with context %}

// Context for buffer allocation
static cmsis_nn_context {{ name }}_ctx;

// Runtime scratch buffer (max upper bound; actual size queried at runtime)
// Buffer size calculated conservatively to handle MVE and DSP implementations
#define {{ name|upper }}_BUFFER_SIZE_MAX {{ buffer_size_max }}
{{ helia_guard_declare("uint8_t", name ~ "_buffer", name|upper ~ "_BUFFER_SIZE_MAX") }}


#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
{{ helia_guard_declare(output_dtype, name ~ "_output", name|upper ~ "_OUTPUT_SIZE") }}

int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    // Calculate required buffer size
    {% if float_kernel %}
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        &{{ name }}_fc_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims,
        {{ kernel_layout }}
    );
    {% elif kernel_fn == 'arm_fully_connected_s4' %}
    int32_t required_buffer_size = 0;
    {% elif quant_params.per_channel and output_dtype == 'int16_t' %}
    // For per-channel S16, use per_channel buffer size function
    int32_t required_buffer_size = arm_fully_connected_per_channel_s16_get_buffer_size(
        &{{ name }}_filter_dims
    );
    {% else %}
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        &{{ name }}_filter_dims
    );
    {% endif %}

    if (required_buffer_size > {{ name|upper }}_BUFFER_SIZE_MAX) {
        printf("Buffer size error: required=%d > max=%d\r\n", required_buffer_size, {{ name|upper }}_BUFFER_SIZE_MAX);
        return ARM_CMSIS_NN_ARG_ERROR;
    }

    // Armed unconditionally: {{ name }}_buffer is only ctx.buf in some branches
    // below (s4 uses NULL, weight_sum variants point ctx.buf elsewhere), but
    // poisoning/guarding it here regardless is harmless and keeps the check
    // in _test_case_run unconditional too.
    HELIA_GUARD_ARM({{ name }}_buffer, true /* pure scratch: poison to catch read-before-write */);

    // Initialize context buffer
    {% if float_kernel %}
    {{ name }}_ctx.buf = {{ name }}_buffer;
    {{ name }}_ctx.size = required_buffer_size;
    {% elif kernel_fn == 'arm_fully_connected_s4' %}
    {{ name }}_ctx.buf = NULL;
    {{ name }}_ctx.size = 0;
    {% elif has_weight_sum %}
    // For S8 fully connected with weight_sum, the ctx buffer should point to precomputed weight_sum
    // Weight sum is precomputed at code generation time and embedded in header
    // ctx.size must be in bytes: filter_dims.c * sizeof(int32_t)
    {{ name }}_ctx.buf = (uint8_t *){{ name }}_weight_sum;
    {{ name }}_ctx.size = {{ filter_dims.c }} * 4;  // sizeof(int32_t) = 4
    {% else %}
    {{ name }}_ctx.buf = {{ name }}_buffer;
    {{ name }}_ctx.size = required_buffer_size;
    {% endif %}
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u);

    // Call fully connected kernel via wrapper (handles per-channel/per-tensor)
    {% if float_kernel %}
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_ctx,
        &{{ name }}_fc_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        {{ name }}_weights,
        &{{ name }}_bias_dims,
        {% if has_biases %}
        {{ name }}_biases,
        {% else %}
        NULL,
        {% endif %}
        &{{ name }}_output_dims,
        output,
        {{ kernel_layout }}
    );
    {% elif kernel_fn == 'arm_fully_connected_s4' %}
    arm_cmsis_nn_status kernel_status = arm_fully_connected_s4(
        &{{ name }}_ctx,
        &{{ name }}_fc_params,
        &{{ name }}_quant_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        {{ name }}_weights,
        &{{ name }}_bias_dims,
        {% if has_biases %}
        {{ name }}_biases,
        {% else %}
        NULL,
        {% endif %}
        &{{ name }}_output_dims,
        output
    );
    {% else %}
    cmsis_nn_quant_params quant_params_wrapper = {
        {% if quant_params.per_channel %}
        .multiplier = (int32_t*){{ name }}_multiplier,
        .shift = (int32_t*){{ name }}_shift,
        .is_per_channel = 1
        {% else %}
        .multiplier = (int32_t*)&{{ name }}_multiplier_val,
        .shift = (int32_t*)&{{ name }}_shift_val,
        .is_per_channel = 0
        {% endif %}
    };
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_ctx,
        &{{ name }}_fc_params,
        &quant_params_wrapper,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        {{ name }}_weights,
        &{{ name }}_bias_dims,
        {% if has_biases %}
        {{ name }}_biases,
        {% else %}
        NULL,
        {% endif %}
        &{{ name }}_output_dims,
        output
    );
    {% endif %}
    
    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    int32_t status = {{ name }}_run({{ name }}_input, {{ name }}_output);
    int failures = 0;
    HELIA_GUARD_CHECK({{ name }}_buffer, "{{ validation_label | default("Fully connected") }} scratch", failures);
    HELIA_GUARD_CHECK_SLACK({{ name }}_buffer, "{{ validation_label | default("Fully connected") }} scratch slack", {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u, failures);
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("Fully connected") }} output", failures);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Fully connected") }}", status);

{{ validation_outputs(validation_mode_token | default("TOLERANT_INT"), validation_tolerance | default(1)) }}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
