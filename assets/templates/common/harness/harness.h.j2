{#
  Generic harness header: every data declaration the case carries, rendered from the
  operator's ArgumentPool (generation/harness). Nothing here is specific to an operator.
#}
#ifndef {{ name|upper }}_HARNESS_H
#define {{ name|upper }}_HARNESS_H

#include <stdint.h>
// Input arrays may carry NAN/INFINITY tokens, and this header is included ahead of
// any other translation-unit include that would define them.
#include <math.h>
{% for header in hct_harness().header_includes %}
#include "{{ header }}"
{% endfor %}

{% for declaration in header_declarations %}
{{ declaration }}

{% endfor %}
{% if header_text %}
{{ header_text }}

{% endif %}
#endif
