int32_t {{ name }}_test_case_run(void)
{
    {% if pool.test_prologue %}
{{ pool.test_prologue }}
    {% endif %}
    {% if harness.outputs %}
    {% for slot in harness.outputs %}
    {% if slot.count > 0 %}
    HELIA_GUARD_ARM({{ slot.name }}_output, false /* real output, not scratch: don't poison */);
    {% else %}
    HELIA_GUARD_ARM({{ slot.name }}_output, true /* zero-extent slice must not be written: poison */);
    {% endif %}
    {% endfor %}
    {% elif autovectorize_declines %}
#if defined(HELIA_CMSIS_NN_INT_AUTOVECTORIZE)
    HELIA_GUARD_ARM({{ name }}_output, true /* the entry declines on this build: poison */);
#else
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
#endif
    {% elif expected_status | default("ARM_CMSIS_NN_SUCCESS") != "ARM_CMSIS_NN_SUCCESS" %}
    HELIA_GUARD_ARM({{ name }}_output, true /* a declined call must not write it: poison */);
    {% elif pool.output_poison %}
    HELIA_GUARD_ARM({{ name }}_output, true /* poisoned: the kernel must write every element it owns */);
    {% else %}
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    {% endif %}
    int32_t status = {{ name }}_run({% for local, ctype, array in harness.inputs %}{{ array }}{{ ", " if not (loop.last and harness.outputs) }}{% endfor %}{% if not harness.outputs %}{{ name }}_output{% endif %});
    int failures = 0;
    {% for result_var, call, fn, expected in harness.checks %}
    int32_t {{ result_var }} = {{ call }};
    if ({{ result_var }} != {{ expected }}) {
        printf("{{ fn }} returned %ld, expected {{ expected }}\r\n", (long){{ result_var }});
        ++failures;
    }
    {% endfor %}
    {% if harness.scratch_buffer %}
    HELIA_GUARD_CHECK({{ name }}_buffer, "{{ label }} scratch", failures);
    HELIA_GUARD_CHECK_SLACK({{ name }}_buffer, "{{ label }} scratch slack", {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u, failures);
    {% endif %}
    {% for block in harness.providers %}
    {% for buffer in block.buffers %}
    HELIA_GUARD_CHECK({{ buffer.name }}, "{{ label }} {{ buffer.label }}", failures);
    {% endfor %}
    {% endfor %}
    {% for slot in harness.outputs %}
    HELIA_GUARD_CHECK({{ slot.name }}_output, "{{ label }} {{ slot.name }} output", failures);
    {% if slot.count == 0 %}
    HELIA_GUARD_CHECK_UNTOUCHED({{ slot.name }}_output, "{{ label }} {{ slot.name }} output", failures);
    {% endif %}
    {% else %}
    HELIA_GUARD_CHECK({{ name }}_output, "{{ label }} output", failures);
    {% if pool.output_untouched %}
    HELIA_GUARD_CHECK_UNTOUCHED({{ name }}_output, "{{ label }} output", failures);
    {% endif %}
    {% endfor %}
    {% if pool.extra_checks %}
{{ pool.extra_checks }}
    {% endif %}
    {% if harness.outputs %}
    HELIA_VALIDATE_STATUS("{{ label }}", status);

    {% for slot in harness.outputs %}
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("TOLERANT_INT") }},
        {{ slot.name }}_output,
        {{ slot.name }}_expected_output,
        {{ slot.name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
    {% endfor %}
    {% elif autovectorize_declines %}
#if defined(HELIA_CMSIS_NN_INT_AUTOVECTORIZE)
    HELIA_GUARD_CHECK_UNTOUCHED({{ name }}_output, "{{ label }} output", failures);
    HELIA_VALIDATE_EXPECTED_STATUS(
        "{{ label }}",
        status,
        ARM_CMSIS_NN_NO_IMPL_ERROR
    );
#else
    HELIA_VALIDATE_STATUS("{{ label }}", status);

{{ validation_outputs(validation_mode_token | default("TOLERANT_INT"), validation_tolerance | default(1)) }}
#endif
    {% elif expected_status | default("ARM_CMSIS_NN_SUCCESS") != "ARM_CMSIS_NN_SUCCESS" %}
    HELIA_GUARD_CHECK_UNTOUCHED({{ name }}_output, "{{ label }} output", failures);
    HELIA_VALIDATE_EXPECTED_STATUS(
        "{{ label }}",
        status,
        {{ expected_status }}
    );
    {% else %}
    HELIA_VALIDATE_STATUS("{{ label }}", status);

    {% if pool.validation is not none %}
{{ pool.validation }}
    {% else %}
{{ validation_outputs(validation_mode_token | default("TOLERANT_INT"), validation_tolerance | default(1)) }}
    {% endif %}
    {% endif %}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}
{% endif %}

