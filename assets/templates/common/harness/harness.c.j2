{% if use_batch_harness %}
// Non-static: HELIA_BATCH_BENCHMARK links every generated test's .c file into a single
// executable (see scripts/gen_batch_harness.py); names are unique per test.
int32_t {{ name }}_bench_init(void)
{% else %}
static int32_t {{ name }}_bench_init(void)
{% endif %}
{
    {{ harness_init() }}
