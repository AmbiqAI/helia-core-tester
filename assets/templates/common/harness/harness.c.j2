{#
  Shared by the correctness path ({{name}}_run) and the benchmark path ({{name}}_bench_init /
  {{name}}_bench_op), so the two can never drift apart: only the timing boundary differs.
#}
{% macro harness_init() %}
    {% if harness.sizer_call %}
    // Calculate required buffer size
    int32_t required_buffer_size = {{ harness.sizer_call }};
    {% elif harness.scratch_buffer and not (force_no_scratch | default(false) or harness.no_scratch or harness.context_setup) %}
    // The entry takes no scratch query (entry_scratch in the descriptor).
    int32_t required_buffer_size = {{ harness.scratch_bytes }};
    {% endif %}
    {% for var, call, fn, capacity in harness.size_queries %}
    int32_t {{ var }} = {{ call }};
    {% endfor %}
    // Armed before the capacity check below: an early return there would otherwise leave
    // these canaries unstamped, and the unconditional check in _test_case_run would
    // report a fabricated breach instead of the real sizer error (#68).
    {% if harness.scratch_buffer %}
    HELIA_GUARD_ARM({{ name }}_buffer, true /* pure scratch: poison to catch read-before-write */);
    {% endif %}
    {% for block in harness.providers %}
    {% for buffer in block.buffers %}
    HELIA_GUARD_ARM({{ buffer.name }}, true /* fully recomputed below: poison-safe */);
    {% endfor %}
    {% endfor %}
    {% if harness.scratch_buffer %}
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, 0u);
    {% endif %}

    // The sizer's answer is checked before it becomes a context size (#133): a negative
    // answer is the documented out-of-range sentinel, and one above this case's static bound
    // means the generation-time bound and the shipped kernel disagree.
    {% if harness.sizer_fn %}
    HELIA_VALIDATE_SIZER("{{ harness.sizer_fn }}", required_buffer_size);
    HELIA_VALIDATE_SIZER_FITS("{{ harness.sizer_fn }}", required_buffer_size, {{ name|upper }}_BUFFER_SIZE_MAX);
    {% endif %}
    {% for var, call, fn, capacity in harness.size_queries %}
    HELIA_VALIDATE_SIZER("{{ fn }}", {{ var }});
    HELIA_VALIDATE_SIZER_FITS("{{ fn }}", {{ var }}, {{ capacity }});
    {% endfor %}

    {% if harness.uses_ctx %}
    // Initialize context buffer
    {% if force_no_scratch | default(false) %}
    // force_no_scratch: the kernel gets no scratch buffer ({{ name }}_buffer stays armed and unused).
    {{ name }}_ctx.buf = NULL;
    {{ name }}_ctx.size = 0;
    {% elif harness.no_scratch %}
    // The kernel gets no scratch buffer.
    {{ name }}_ctx.buf = NULL;
    {{ name }}_ctx.size = 0;
    {% elif harness.context_setup %}
{{ harness.context_setup }}
    {% else %}
    {{ name }}_ctx.buf = {{ name }}_buffer;
    {{ name }}_ctx.size = required_buffer_size;
    {% endif %}
    {% endif %}
    {% if harness.scratch_buffer %}
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u);
    {% endif %}
    {% for block in harness.providers %}

{{ block.setup }}
    {% endfor %}
    {% if harness.fault_setup %}

{{ harness.fault_setup }}
    {% if harness.scratch_buffer %}
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u);
    {% endif %}
    {% endif %}
{% endmacro %}
int32_t {{ name }}_run(
    {% for local, ctype, array in harness.inputs %}
    const {{ ctype or input_dtype }}* __restrict {{ local }}{{ "," if not (loop.last and harness.outputs) }}
    {% endfor %}
    {% if not harness.outputs %}
    {{ output_dtype }}* __restrict output{{ "," if pool.run_params }}
    {% endif %}
    {% for local, ctype in pool.run_params %}
    {{ ctype }} {{ local }}{{ "," if not loop.last }}
    {% endfor %}
) {
    {{ harness_init() }}
    {% if pool.pre_call %}
{{ pool.pre_call }}
    {% endif %}
    {% if harness.run_calls and harness.void_return %}
    {% for call in harness.run_calls %}
    {{ call }};
    {% endfor %}
    return ARM_CMSIS_NN_SUCCESS;
    {% elif harness.run_calls %}
    arm_cmsis_nn_status kernel_status = ARM_CMSIS_NN_SUCCESS;
    {% for call in harness.run_calls %}
    kernel_status = {{ call }};
    if (kernel_status != ARM_CMSIS_NN_SUCCESS) {
        return kernel_status;
    }
    {% endfor %}
    {% if pool.post_call %}
{{ pool.post_call }}
    {% endif %}
    return kernel_status;
    {% elif harness.void_return %}
    {{ harness.run_call }};
    return ARM_CMSIS_NN_SUCCESS;
    {% else %}
    return {{ harness.run_call }};
    {% endif %}
}

