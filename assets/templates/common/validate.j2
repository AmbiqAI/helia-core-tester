#ifndef HELIA_CORE_TEMPLATE_VALIDATE_H
#define HELIA_CORE_TEMPLATE_VALIDATE_H

#include <math.h>
#include <stdbool.h>

static inline void helia_test_print_failure_count(int failures)
{
    printf("%d Failures\r\n", failures);
}

#define HELIA_VALIDATE_EXACT_INTS(actual, expected, size, failures) \
    do { \
        for (int helia_i = 0; helia_i < (size); ++helia_i) { \
            long long helia_act_val = (long long)((actual)[helia_i]); \
            long long helia_exp_val = (long long)((expected)[helia_i]); \
            if (helia_act_val != helia_exp_val) { \
                ++(failures); \
                if ((failures) <= 20) { \
                    printf("Mismatch[%d]: exp=%lld got=%lld\r\n", helia_i, helia_exp_val, helia_act_val); \
                } \
            } \
        } \
    } while (0)

#define HELIA_VALIDATE_TOLERANT_INTS(actual, expected, size, tolerance, failures) \
    do { \
        for (int helia_i = 0; helia_i < (size); ++helia_i) { \
            long long helia_act_val = (long long)((actual)[helia_i]); \
            long long helia_exp_val = (long long)((expected)[helia_i]); \
            long long helia_diff = helia_act_val - helia_exp_val; \
            if (helia_diff < 0) { \
                helia_diff = -helia_diff; \
            } \
            if (helia_diff > (long long)(tolerance)) { \
                ++(failures); \
                if ((failures) <= 20) { \
                    printf( \
                        "Mismatch[%d]: exp=%lld got=%lld (diff=%lld)\r\n", \
                        helia_i, \
                        helia_exp_val, \
                        helia_act_val, \
                        helia_diff \
                    ); \
                } \
            } \
        } \
    } while (0)

#define HELIA_VALIDATE_FLOATS(actual, expected, size, tolerance, failures) \
    do { \
        for (int helia_i = 0; helia_i < (size); ++helia_i) { \
            double helia_act_val = (double)((actual)[helia_i]); \
            double helia_exp_val = (double)((expected)[helia_i]); \
            double helia_diff = fabs(helia_act_val - helia_exp_val); \
            if (helia_diff > (double)(tolerance)) { \
                ++(failures); \
                if ((failures) <= 20) { \
                    printf( \
                        "Mismatch[%d]: exp=%.6f got=%.6f (diff=%.6f, tol=%.6f)\r\n", \
                        helia_i, \
                        helia_exp_val, \
                        helia_act_val, \
                        helia_diff, \
                        (double)(tolerance) \
                    ); \
                } \
            } \
        } \
    } while (0)

#define HELIA_VALIDATE_BOOLEANS(actual, expected, size, failures) \
    do { \
        for (int helia_i = 0; helia_i < (size); ++helia_i) { \
            int helia_act_val = ((actual)[helia_i]) ? 1 : 0; \
            int helia_exp_val = ((expected)[helia_i]) ? 1 : 0; \
            if (helia_act_val != helia_exp_val) { \
                ++(failures); \
                if ((failures) <= 20) { \
                    printf("Mismatch[%d]: exp=%d got=%d\r\n", helia_i, helia_exp_val, helia_act_val); \
                } \
            } \
        } \
    } while (0)

#endif
