{#
 Output validation call site, shared by the operator templates whose descriptors
 can carry nonfinite_policy: mask (issue #74).

 A mask-policy case adds one context key, nonfinite_mask_array_str, holding the
 don't-care byte per output element. It is emitted here rather than in the
 generated .h so no per-operator header template has to know the policy exists,
 and the plain branch is byte-identical to the call site it replaced so a case
 without a mask keeps its golden.
#}
{% macro validation_outputs(mode, tolerance) %}
{% if nonfinite_mask_array_str %}
    static const uint8_t {{ name }}_expected_mask[] = {
{{ nonfinite_mask_array_str }}
    };
    HELIA_VALIDATE_FLOATS_MASKED(
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name }}_expected_mask,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
{%- else %}
    HELIA_VALIDATE_OUTPUTS(
        {{ mode }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ tolerance }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
{%- endif %}
{%- endmacro %}
