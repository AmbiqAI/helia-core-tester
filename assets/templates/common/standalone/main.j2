{% set supports_benchmark = supports_benchmark | default(false) %}
int main(void)
{
    helia_test_platform_init();
{% if supports_benchmark %}
#ifdef HELIA_BENCHMARK_MODE
    {{ prefix }}_{{ name }}_benchmark_run();
    helia_test_finish(0);
#else
    int32_t failures = {{ prefix }}_{{ name }}_test_case_run();
    helia_test_finish(failures);
#endif
{% else %}
    int32_t failures = {{ prefix }}_{{ name }}_test_case_run();
    helia_test_finish(failures);
{% endif %}
}
