#include "{{ name }}_tree_walk.h"
#include <string.h>
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}
{{ helia_guard_declare("int32_t", "ids", 2) }}
{{ helia_guard_declare("float32_t", "values", 2) }}
{{ helia_guard_declare("float32_t", "scores", 2) }}
{{ helia_guard_declare("int32_t", "winner", 1) }}

int32_t {{ name }}_test_case_run(void)
{
    cmsis_nn_tree_table_f32 table = {nodes, roots, 2, 4, 2, 1};
    static const uint32_t inputs[] = {0, 0x3f800000, 0x7fc00001};
    static const int32_t expected_ids[][2] = { {0, 2}, {1, 3}, {0, 3} };
    static const float32_t expected_values[][2] = { {-4, 3}, {2, 8}, {-4, 8} };
    static const float32_t expected_scores[][2] = { {3, 2}, {2, 2}, {1, 3} };
    static const int32_t expected_winner[] = {0, 0, 1};
    int failures = 0;
    for (unsigned i = 0; i < 3; ++i)
    {
        float32_t row;
        memcpy(&row, &inputs[i], sizeof(row));
        HELIA_GUARD_ARM(ids, true);
        HELIA_GUARD_ARM(values, true);
        HELIA_GUARD_ARM(scores, true);
        HELIA_GUARD_ARM(winner, true);
        HELIA_VALIDATE_STATUS("leaf IDs", arm_nn_tree_walk_f32(&row, &table, ids));
        HELIA_VALIDATE_STATUS("leaf values", arm_nn_tree_walk_values_f32(&row, &table, leaf_values, 4, values));
        HELIA_VALIDATE_STATUS("mean scores", arm_nn_tree_walk_mean_argmax_f32(&row, &table, leaf_scores, 2, scores, winner));
        HELIA_GUARD_CHECK(ids, "leaf IDs", failures);
        HELIA_GUARD_CHECK(values, "leaf values", failures);
        HELIA_GUARD_CHECK(scores, "mean scores", failures);
        HELIA_GUARD_CHECK(winner, "winner", failures);
        if (memcmp(ids, expected_ids[i], sizeof(ids)) || memcmp(values, expected_values[i], sizeof(values))
            || memcmp(scores, expected_scores[i], sizeof(scores)) || winner[0] != expected_winner[i])
        {
            printf("packed tree mismatch on row %u\n", i);
            ++failures;
        }
    }
    float32_t row = 0.0f;
    table.feature_count = 0;
    HELIA_VALIDATE_EXPECTED_STATUS("invalid table", arm_nn_tree_walk_f32(&row, &table, ids), ARM_CMSIS_NN_ARG_ERROR);
    HELIA_VALIDATE_EXPECTED_STATUS("invalid table", arm_nn_tree_walk_values_f32(&row, &table, leaf_values, 4, values), ARM_CMSIS_NN_ARG_ERROR);
    HELIA_VALIDATE_EXPECTED_STATUS("invalid table", arm_nn_tree_walk_mean_argmax_f32(&row, &table, leaf_scores, 2, scores, winner), ARM_CMSIS_NN_ARG_ERROR);
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}
{% include "common/standalone/main.j2" %}
