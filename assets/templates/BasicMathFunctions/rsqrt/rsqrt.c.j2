#include "{{ name }}_rsqrt.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
static {{ output_dtype }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];

int32_t {{ prefix }}_{{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    arm_cmsis_nn_status kernel_status =
{% if call_style == "universal" %}
        {{ kernel_fn }}(
            input,
            {{ input_offset }},       // input_offset
            output,
            {{ output_offset }},      // out_offset
            {{ out_mult }},           // out_mult
            {{ out_shift }},          // out_shift
            {{ needs_rescale }},      // needs_rescale
            {{ out_activation_min }}, // out_activation_min
            {{ out_activation_max }}, // out_activation_max
            {{ block_size }},         // block_size
            {{ name }}_rsqrt_lut
        );
{% else %}
        {{ kernel_fn }}(
            input,
            {{ input_offset }},       // input_offset
            output,
            {{ output_offset }},      // out_offset
            {{ out_activation_min }}, // out_activation_min
            {{ out_activation_max }}, // out_activation_max
            {{ block_size }},         // block_size
            {{ name }}_rsqrt_lut
        );
{% endif %}

    return kernel_status;
}

int32_t {{ prefix }}_{{ name }}_test_case_run(void)
{
    int32_t status = {{ prefix }}_{{ name }}_run({{ name }}_input, {{ name }}_output);
    HELIA_VALIDATE_EXPECTED_STATUS(
        "{{ validation_label | default("Rsqrt") }}",
        status,
        {{ expected_status | default("ARM_CMSIS_NN_SUCCESS") }}
    );

{% if expected_status | default("ARM_CMSIS_NN_SUCCESS") == "ARM_CMSIS_NN_SUCCESS" %}
    int failures = 0;
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("TOLERANT_INT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(3) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
{% else %}
    HELIA_VALIDATE_RETURN_FAILURES(0);
{% endif %}
}

{% include "common/standalone/main.j2" %}
