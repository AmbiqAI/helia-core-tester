#include "{{ name }}_reduce_max.h"
#include "arm_nnfunctions.h"
{% if float_kernel %}
#include <string.h>
{% endif %}
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
{{ helia_guard_declare(output_dtype, name ~ "_output", name|upper ~ "_OUTPUT_SIZE") }}
{% if float_kernel %}
static {{ input_dtype }} {{ name }}_input[{{ input_count if input_count else 1 }}];
{% endif %}

int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    // Call ReduceMax kernel
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        input,
        &{{ name }}_input_dims,
        &{{ name }}_axis_dims,
        output,
        &{{ name }}_output_dims
    );
    
    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
{% if float_kernel %}
    memcpy({{ name }}_input, {{ name }}_input_bits, {{ input_count }} * sizeof({{ input_dtype }}));
{% endif %}
    HELIA_GUARD_ARM({{ name }}_output, {{ 'true' if float_kernel else 'false' }});
    int32_t status = {{ name }}_run({{ 'NULL' if float_kernel and input_count == 0 else name ~ '_input' }}, {{ name }}_output);
    int failures = 0;
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("ReduceMax") }} output", failures);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("ReduceMax") }}", status);

{% if float_kernel %}
    if (memcmp({{ name }}_input, {{ name }}_input_bits, {{ input_count }} * sizeof({{ input_dtype }})) != 0) ++failures;
    for (int i = 0; i < {{ name|upper }}_OUTPUT_SIZE; ++i) {
        {{ word_type }} actual;
        memcpy(&actual, {{ name }}_output + i, sizeof(actual));
        HELIA_VALIDATE_FLOAT_BITS(actual, {{ name }}_expected_bits[i], {{ infinity_bits }}, 0, i, 20, failures);
    }
{% else %}
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("TOLERANT_INT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
{% endif %}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
