#include "{{ name }}_squared_difference.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
static {{ output_dtype }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];

int32_t {{ prefix }}_{{ name }}_run(
    const {{ input_dtype }}* __restrict input1,
    const {{ input_dtype }}* __restrict input2,
    {{ output_dtype }}* __restrict output
) {
    // Call squared difference kernel
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
{% if call_style and call_style|lower == 'elementwise' %}
        input1,
        input2,
        {{ input1_offset }},       // input1_offset
        {{ input1_mult }},         // input1_mult
        {{ input1_shift }},        // input1_shift
        {{ input2_offset }},       // input2_offset
        {{ input2_mult }},         // input2_mult
        {{ input2_shift }},        // input2_shift
        {{ left_shift }},          // left_shift
        output,
        {{ out_offset }},          // out_offset
        {{ out_mult }},            // out_mult
        {{ out_shift }},           // out_shift
        {{ out_activation_min }}, // out_activation_min
        {{ out_activation_max }}, // out_activation_max
        {{ block_size }}           // block_size
{% else %}
        input1,
        &{{ name }}_input1_dims,
        input2,
        &{{ name }}_input2_dims,
        {{ input1_offset }},       // input1_offset
        {{ input1_mult }},         // input1_mult
        {{ input1_shift }},        // input1_shift
        {{ input2_offset }},       // input2_offset
        {{ input2_mult }},         // input2_mult
        {{ input2_shift }},        // input2_shift
        {{ left_shift }},          // left_shift
        output,
        &{{ name }}_output_dims,
        {{ out_offset }},          // out_offset
        {{ out_mult }},            // out_mult
        {{ out_shift }},           // out_shift
        {{ out_activation_min }}, // out_activation_min
        {{ out_activation_max }}  // out_activation_max
{% endif %}
    );
    
    return kernel_status;
}

int32_t {{ prefix }}_{{ name }}_test_case_run(void)
{
    const arm_cmsis_nn_status expected = ARM_CMSIS_NN_SUCCESS;
    int32_t status = {{ prefix }}_{{ name }}_run({{ name }}_input1, {{ name }}_input2, {{ name }}_output);
    if (status != expected) {
        printf("SquaredDifference failed with status %d\r\n", status);
        printf("1 Failures\r\n");
        return 1;
    }

    // Verify outputs (allow tolerance based on dtype)
    int failures = 0;
    const int output_size = {{ name|upper }}_OUTPUT_SIZE;
{% if output_dtype == 'int16_t' %}
    const int tolerance = 3;
{% else %}
    const int tolerance = 1;
{% endif %}

    const {{ output_dtype }} *act = {{ name }}_output;
    const {{ output_dtype }} *exp = {{ name }}_expected_output;

    for (int i = 0; i < output_size; i++) {
        int act_val = (int)act[i];
        int exp_val = (int)exp[i];
        int diff = act_val - exp_val;
        if (diff < 0) diff = -diff;  // absolute difference
        if (diff > tolerance) {
            failures++;
            if (failures <= 20) {
                printf("Mismatch[%d]: exp=%d got=%d (diff=%d)\r\n", i, exp_val, act_val, diff);
            }
        }
    }

    printf("%d Failures\r\n", failures);
    return failures;
}

{% include "common/standalone/main.j2" %}
