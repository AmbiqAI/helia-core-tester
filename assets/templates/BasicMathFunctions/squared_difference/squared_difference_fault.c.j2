#include "{{ name }}_squared_difference.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
{# Declare the output only when this fault mode passes it, so a NULL-substituted
   buffer never becomes an unused static (-Wunused-variable). #}
{% if fault != "null_output" %}
{{ helia_guard_declare(output_dtype, name ~ "_output", name|upper ~ "_OUTPUT_SIZE") }}
{% endif %}

/*
 * Fault-injection test case: exercises the {{ kernel_fn }}
 * argument-validation branch. Fault mode: {{ fault }}.
 */
static int32_t run_squared_difference(void)
{
    const {{ input_dtype }} *input1_arg = {% if fault == "null_input_1" %}NULL{% else %}{{ name }}_input1{% endif %};
    const {{ input_dtype }} *input2_arg = {% if fault == "null_input_2" %}NULL{% else %}{{ name }}_input2{% endif %};
    {{ output_dtype }} *output_arg = {% if fault == "null_output" %}NULL{% else %}{{ name }}_output{% endif %};
{% if fault == "zero_block" %}
    const int32_t block_size = 0;
{% elif fault == "negative_block" %}
    const int32_t block_size = -1;
{% else %}
    const int32_t block_size = {{ block_size }};
{% endif %}

    return {{ kernel_fn }}(input1_arg, input2_arg, output_arg, block_size);
}

int32_t {{ name }}_test_case_run(void)
{
{% if fault != "null_output" %}
    /* A rejected call must leave the output untouched: poison it and require
       the poison and its guard words to survive. */
    HELIA_GUARD_ARM({{ name }}_output, true /* poison: nothing may be written */);
{% endif %}
    int32_t status = run_squared_difference();
    int failures = 0;
{% if fault != "null_output" %}
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("SquaredDifference") }} output", failures);
    HELIA_GUARD_CHECK_UNTOUCHED({{ name }}_output, "{{ validation_label | default("SquaredDifference") }} output", failures);
{% endif %}
    HELIA_VALIDATE_EXPECTED_STATUS(
        "{{ validation_label | default("SquaredDifference") }}",
        status,
        {{ expected_status }}
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
