#include "{{ name }}_sub.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
static {{ output_dtype }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];

int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input1,
    const {{ input_dtype }}* __restrict input2,
    {{ output_dtype }}* __restrict output
) {
    // Call subtract kernel
    {% if float_kernel %}
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        input1,
        input2,
        output,
        {{ out_activation_min_literal }},
        {{ out_activation_max_literal }},
        {{ block_size }}
    );
    {% else %}
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
{% if call_style and call_style|lower == 'elementwise' %}
        input1,
        input2,
        {{ input1_offset }},      // input1_offset
        {{ input1_mult }},       // input1_mult
        {{ input1_shift }},      // input1_shift
        {{ input2_offset }},     // input2_offset
        {{ input2_mult }},       // input2_mult
        {{ input2_shift }},      // input2_shift
        {{ left_shift }},        // left_shift
        output,
        {{ out_offset }},        // out_offset
        {{ out_mult }},          // out_mult
        {{ out_shift }},         // out_shift
        {{ out_activation_min }}, // out_activation_min
        {{ out_activation_max }}, // out_activation_max
        {{ block_size }}         // block_size
{% else %}
        input1,
        &{{ name }}_input1_dims,
        input2,
        &{{ name }}_input2_dims,
        {{ input1_offset }},      // input1_offset
        {{ input1_mult }},       // input1_mult
        {{ input1_shift }},      // input1_shift
        {{ input2_offset }},     // input2_offset
        {{ input2_mult }},       // input2_mult
        {{ input2_shift }},      // input2_shift
        {{ left_shift }},        // left_shift
        output,
        &{{ name }}_output_dims,
        {{ out_offset }},        // out_offset
        {{ out_mult }},          // out_mult
        {{ out_shift }},         // out_shift
        {{ out_activation_min }}, // out_activation_min
        {{ out_activation_max }}  // out_activation_max
{% endif %}
    );
    {% endif %}
    
    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
    int32_t status = {{ name }}_run({{ name }}_input1, {{ name }}_input2, {{ name }}_output);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Sub") }}", status);

    int failures = 0;
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("TOLERANT_INT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
