#include "{{ name }}_rbf_kernel.h"
#include <string.h>
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}
{{ helia_guard_declare("float32_t", "output", rows) }}

int32_t {{ name }}_test_case_run(void)
{
    int failures = 0;
    HELIA_GUARD_ARM(output, true);
    arm_cmsis_nn_status status = arm_nn_rbf_kernel_f32(row, references, 0, {{ features }}, -0.25f, output);
    HELIA_GUARD_CHECK(output, "empty RBF", failures);
    HELIA_GUARD_CHECK_UNTOUCHED(output, "empty RBF", failures);
    HELIA_VALIDATE_EXPECTED_STATUS("empty RBF", status, ARM_CMSIS_NN_ARG_ERROR);
    status = arm_nn_rbf_kernel_f32(row, references, {{ rows }}, {{ features }}, -0.25f, output);
    HELIA_GUARD_CHECK(output, "RBF", failures);
    HELIA_VALIDATE_STATUS("RBF", status);
    for (unsigned i = 0; i < {{ rows }}; ++i)
    {
        uint32_t actual;
        memcpy(&actual, &output[i], sizeof(actual));
        HELIA_VALIDATE_FLOAT_BITS(actual, expected_rbf[i], 0x7f800000u,
                                  expected_squares[i] == 0 ? 0u : 2u, i, 8, failures);
    }
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}
