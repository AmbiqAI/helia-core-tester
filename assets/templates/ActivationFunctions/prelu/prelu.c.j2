#include "{{ name }}_prelu.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
{{ helia_guard_declare(output_dtype, name ~ "_output", name|upper ~ "_OUTPUT_SIZE") }}

int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    // Call PReLU kernel
    {% if float_kernel %}
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_input_dims,
        input,
        &{{ name }}_alpha_dims,
        {{ name }}_alpha,
        &{{ name }}_output_dims,
        output
    );
    {% else %}
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_input_dims,
        input,
        &{{ name }}_alpha_dims,
        {{ name }}_alpha,
        {{ input_offset }},              // input_offset (already negated in Python: -input_zero_point)
        {{ alpha_offset }},              // alpha_offset (already negated in Python: -alpha_zero_point)
        {{ output_offset }},              // output_offset (zero point as-is)
        {{ output_mult_identity }},      // output_multiplier_identity
        {{ output_shift_identity }},     // output_shift_identity
        {{ output_mult_alpha }},         // output_multiplier_alpha
        {{ output_shift_alpha }},        // output_shift_alpha
        &{{ name }}_output_dims,
        output
    );
    {% endif %}
    
    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    int32_t status = {{ name }}_run({{ name }}_input, {{ name }}_output);
    HELIA_VALIDATE_EXPECTED_STATUS(
        "{{ validation_label | default("PReLU") }}",
        status,
        {{ expected_status | default("ARM_CMSIS_NN_SUCCESS") }}
    );

    int failures = 0;
    // Checked unconditionally, even for expected-error cases: a kernel that
    // correctly rejects the call can still have corrupted the output boundary
    // on the way there, and that must not be masked by the "no output
    // comparison for error cases" branch below.
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("PReLU") }} output", failures);
{% if expected_status | default("ARM_CMSIS_NN_SUCCESS") == "ARM_CMSIS_NN_SUCCESS" %}
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("TOLERANT_INT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
{% endif %}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
