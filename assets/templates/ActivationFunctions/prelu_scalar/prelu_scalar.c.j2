#include "{{ name }}_prelu_scalar.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ num_pixels | default(1) }} * {{ block_size }})
{{ helia_guard_declare(output_dtype, name ~ "_output", name|upper ~ "_OUTPUT_SIZE") }}

int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict scalar_input,
    const {{ input_dtype }}* __restrict alpha,
    {{ output_dtype }}* __restrict output
) {
    arm_cmsis_nn_status kernel_status = ARM_CMSIS_NN_SUCCESS;
{% for pixel in range(num_pixels | default(1)) %}
    kernel_status = {{ kernel_fn | default("arm_prelu_scalar_s8") }}(
        scalar_input + {{ pixel }},
        alpha + {{ pixel * block_size }},
        true,
        {{ input_offset }},
        {{ alpha_offset }},
        {{ output_offset }},
        {{ output_mult_identity }},
        {{ output_shift_identity }},
        {{ output_mult_alpha }},
        {{ output_shift_alpha }},
        output + {{ pixel * block_size }},
        {{ block_size }}
    );
    if (kernel_status != ARM_CMSIS_NN_SUCCESS) {
        return kernel_status;
    }
{% endfor %}
    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    int32_t status = {{ name }}_run({{ name }}_scalar_input, {{ name }}_alpha, {{ name }}_output);
    int failures = 0;
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("PReLUScalar") }} output", failures);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("PReLUScalar") }}", status);

    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("TOLERANT_INT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(2) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
