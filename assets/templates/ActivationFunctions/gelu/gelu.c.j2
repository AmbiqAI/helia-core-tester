#include "{{ name }}_gelu.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}
{% from "common/standalone/validation.j2" import validation_outputs with context %}

#define {{ name|upper }}_OUTPUT_SIZE {{ output_size }}
{{ helia_guard_declare(output_dtype, name ~ "_output", name|upper ~ "_OUTPUT_SIZE") }}

int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
{% if fpscr_fz16 %}
#if defined(__arm__) && defined(__ARM_FEATURE_FP16_SCALAR_ARITHMETIC)
    // FPSCR.FZ16 (bit 19) set for the call, then restored.
    uint32_t fpscr;
    __asm__ volatile("vmrs %0, fpscr" : "=r"(fpscr));
    __asm__ volatile("vmsr fpscr, %0" : : "r"(fpscr | (1u << 19)));
#endif
{% endif %}
    // Exact GELU: 0.5 * x * erfc(-x / sqrt(2))
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        input,
        output,
        {{ output_size }}        // size
    );
{% if fpscr_fz16 %}
#if defined(__arm__) && defined(__ARM_FEATURE_FP16_SCALAR_ARITHMETIC)
    __asm__ volatile("vmsr fpscr, %0" : : "r"(fpscr));
#endif
{% endif %}

    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    int32_t status = {{ name }}_run({{ name }}_input, {{ name }}_output);
    int failures = 0;
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("Gelu") }} output", failures);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Gelu") }}", status);

{% if interval_lo_array %}
    failures += helia_test_float_interval(
        {{ name }}_output,
        {{ name }}_interval_lo,
        {{ name }}_interval_hi,
        {{ (name ~ "_interval_zero_ok") if interval_zero_ok_array else "NULL" }},
        {{ name|upper }}_OUTPUT_SIZE,
        {{ interval_width }},
        {{ validation_report_limit | default(20) }}
    );
{% else %}
{{ validation_outputs(validation_mode_token | default("FLOAT"), validation_tolerance | default(1)) }}
{% endif %}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
