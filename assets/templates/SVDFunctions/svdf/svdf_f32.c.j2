#include "{{ name }}_svdf.h"
{% from "common/standalone/validation.j2" import validation_outputs with context %}
{% include "common/standalone/runtime_common.j2" %}

static {{ data_dtype }} {{ name }}_state[{{ state_size }}];
static {{ data_dtype }} {{ name }}_scratch_input[{{ scratch_input_size }}];
static {{ data_dtype }} {{ name }}_scratch_output[{{ scratch_output_size }}];
static {{ data_dtype }} {{ name }}_output[{{ output_size }}];

static int32_t run_svdf(void)
{
    cmsis_nn_context ctx = {0};

    /*
     * Sized by the shipped queries rather than by repeating their formulas
     * here (issue #71). The float half of the public header (arm_nnfunctions_flt)
     * documents both as returning "-1 if either pointer is NULL, if
     * input_dims->n or weights_feature_dims->n is negative, or if the product
     * would not fit in an int32_t", with "the figure and the validation ... the
     * same on every build target", so there is no _dsp / _mve variant to pick
     * between here.
     * The statics stay as the allocation; the queried figure is what the
     * kernel is told, and it has to fit inside them.
     */
    const int32_t input_ctx_size = {{ kernel_fn }}_input_ctx_get_buffer_size(
        &{{ name }}_input_dims,
        &{{ name }}_weights_feature_dims);
    const int32_t output_ctx_size = {{ kernel_fn }}_output_ctx_get_buffer_size(
        &{{ name }}_svdf_params,
        &{{ name }}_input_dims,
        &{{ name }}_weights_feature_dims);

    HELIA_VALIDATE_SIZER("{{ kernel_fn }}_input_ctx_get_buffer_size", input_ctx_size);
    HELIA_VALIDATE_SIZER_FITS("{{ kernel_fn }}_input_ctx_get_buffer_size", input_ctx_size, (int32_t)sizeof({{ name }}_scratch_input));
    HELIA_VALIDATE_SIZER("{{ kernel_fn }}_output_ctx_get_buffer_size", output_ctx_size);
    HELIA_VALIDATE_SIZER_FITS("{{ kernel_fn }}_output_ctx_get_buffer_size", output_ctx_size, (int32_t)sizeof({{ name }}_scratch_output));

    /*
     * Non-NULL even when the query answers 0: the same header records that "a
     * 0 here does NOT mean you may pass { NULL, 0 }". A static array is
     * always non-NULL, so the rule is honoured by construction.
     */
    cmsis_nn_context input_ctx = {.buf = {{ name }}_scratch_input, .size = input_ctx_size};
    cmsis_nn_context output_ctx = {.buf = {{ name }}_scratch_output, .size = output_ctx_size};

    for (int i = 0; i < {{ state_size }}; ++i)
    {
        {{ name }}_state[i] = {{ name }}_initial_state[i];
    }

    arm_cmsis_nn_status status = ARM_CMSIS_NN_SUCCESS;
    for (int step = 0; step < {{ sequence_steps }}; ++step)
    {
        const {{ data_dtype }} *step_input = {{ name }}_input_sequence + (step * {{ input_size }});
        status = {{ kernel_fn }}(
            &ctx,
            &input_ctx,
            &output_ctx,
            &{{ name }}_svdf_params,
            &{{ name }}_input_dims,
            step_input,
            &{{ name }}_state_dims,
            {{ name }}_state,
            &{{ name }}_weights_feature_dims,
            {{ name }}_weights_feature,
            &{{ name }}_weights_time_dims,
            {{ name }}_weights_time,
            &{{ name }}_bias_dims,
            {% if use_bias %}{{ name }}_bias{% else %}NULL{% endif %},
            &{{ name }}_output_dims,
            {{ name }}_output
        );
        if (status != ARM_CMSIS_NN_SUCCESS)
        {
            return status;
        }
    }

    return ARM_CMSIS_NN_SUCCESS;
}

int32_t {{ name }}_test_case_run(void)
{
    int32_t status = run_svdf();
    HELIA_VALIDATE_STATUS("{{ validation_label | default("SVDF") }}", status);

    int failures = 0;
{{ validation_outputs(validation_mode_token | default("FLOAT"), validation_tolerance | default(1), output_size, validation_report_limit | default(8)) }}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

