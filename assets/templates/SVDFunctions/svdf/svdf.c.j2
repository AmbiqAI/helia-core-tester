#include "{{ name }}_svdf.h"
#include "arm_nnfunctions.h"
#include <string.h>
{% include "common/standalone/runtime_common.j2" %}

#define SVDF_OUTPUT_SIZE ({{ name|upper }}_INPUT_BATCHES * {{ name|upper }}_UNIT_COUNT)
static {{ output_dtype }} {{ name }}_output[SVDF_OUTPUT_SIZE];

static int32_t run_svdf(void)
{
    cmsis_nn_svdf_params svdf_params;
    cmsis_nn_per_tensor_quant_params input_quant_params;
    cmsis_nn_per_tensor_quant_params output_quant_params;
    cmsis_nn_context input_ctx;
    cmsis_nn_context output_ctx;
{% if has_ctx %}
    cmsis_nn_context ctx;
{% endif %}

    svdf_params.input_activation.min = {{ name|upper }}_INPUT_ACTIVATION_MIN;
    svdf_params.input_activation.max = {{ name|upper }}_INPUT_ACTIVATION_MAX;
    svdf_params.output_activation.min = {{ name|upper }}_OUTPUT_ACTIVATION_MIN;
    svdf_params.output_activation.max = {{ name|upper }}_OUTPUT_ACTIVATION_MAX;
    svdf_params.input_offset = {{ name|upper }}_INPUT_OFFSET;
    svdf_params.output_offset = {{ name|upper }}_OUTPUT_OFFSET;
    svdf_params.rank = {{ name|upper }}_RANK;

    /*
     * The two staging contexts are sized by the shipped queries rather than by
     * repeating their formulas here (issue #71). Include/arm_nnfunctions.h says
     * of these buffers that the kernel "stages this buffer on every build, not
     * only under MVE, so there is no _dsp / _mve pair to choose between and the
     * validation runs on every target" -- unlike the MVE-gated kernel-sum query
     * below, which does have one and is cross-checked against it.
     */
    const int32_t scratch_size = {{ kernel_fn }}_input_ctx_get_buffer_size(
        &{{ name }}_input_dims,
        &{{ name }}_weights_feature_dims);
    const int32_t scratch_size_out = {{ kernel_fn }}_output_ctx_get_buffer_size(
        &svdf_params,
        &{{ name }}_input_dims,
        &{{ name }}_weights_feature_dims);

    HELIA_VALIDATE_SIZER("{{ kernel_fn }}_input_ctx_get_buffer_size", scratch_size);
    HELIA_VALIDATE_SIZER("{{ kernel_fn }}_output_ctx_get_buffer_size", scratch_size_out);

    /*
     * At least one byte even when the query answers 0: the same header records
     * that "a 0 here does NOT mean you may pass { NULL, 0 }: arm_svdf_s8()
     * rejects a NULL input_ctx->buf with ARM_CMSIS_NN_ARG_ERROR regardless of
     * the size". ctx.size still carries the queried figure, not the allocation.
     */
    input_ctx.buf = malloc(scratch_size > 0 ? (size_t)scratch_size : (size_t)1);
    input_ctx.size = scratch_size;
    output_ctx.buf = malloc(scratch_size_out > 0 ? (size_t)scratch_size_out : (size_t)1);
    output_ctx.size = scratch_size_out;
    if (input_ctx.buf == NULL || output_ctx.buf == NULL) {
        free(input_ctx.buf);
        free(output_ctx.buf);
        return ARM_CMSIS_NN_ARG_ERROR;
    }

{% if has_ctx %}
    const int32_t buf_size = arm_svdf_s8_get_buffer_size(&{{ name }}_weights_feature_dims);
    HELIA_VALIDATE_SIZER("arm_svdf_s8_get_buffer_size", buf_size);
    // Unlike the two staging contexts above, a 0 here does license a NULL buf:
    // the header calls this one "Unused on every other build, where ctx->buf
    // may be NULL", and 0 is exactly what it returns on those builds.
    ctx.buf = buf_size > 0 ? malloc(buf_size) : NULL;
    ctx.size = buf_size;
#if defined(ARM_MATH_MVEI)
    if (ctx.buf != NULL) {
        arm_vector_sum_s8((int32_t *)ctx.buf,
                          {{ name|upper }}_INPUT_HEIGHT,
                          {{ name|upper }}_FEATURE_BATCHES,
                          {{ name }}_weights_feature,
                          -{{ name|upper }}_INPUT_OFFSET,
                          0,
                          NULL);
    }
#endif
{% endif %}

    input_quant_params.multiplier = {{ name|upper }}_INPUT_MULTIPLIER;
    input_quant_params.shift = {{ name|upper }}_INPUT_SHIFT;
    output_quant_params.multiplier = {{ name|upper }}_OUTPUT_MULTIPLIER;
    output_quant_params.shift = {{ name|upper }}_OUTPUT_SHIFT;

    {{ state_dtype }} state_data[{{ name|upper }}_INPUT_BATCHES * {{ name|upper }}_FEATURE_BATCHES * {{ name|upper }}_TIME_BATCHES];
    memcpy(state_data, {{ name }}_state_init, sizeof({{ name }}_state_init));

    memset({{ name }}_output, 0, sizeof({{ name }}_output));

{% if has_ctx %}
    arm_cmsis_nn_status result = {{ kernel_fn }}(&ctx,
                                                 &input_ctx,
                                                 &output_ctx,
                                                 &svdf_params,
                                                 &input_quant_params,
                                                 &output_quant_params,
                                                 &{{ name }}_input_dims,
                                                 {{ name }}_input_data,
                                                 &{{ name }}_state_dims,
                                                 state_data,
                                                 &{{ name }}_weights_feature_dims,
                                                 {{ name }}_weights_feature,
                                                 &{{ name }}_weights_time_dims,
                                                 {{ name }}_weights_time,
                                                 &{{ name }}_bias_dims,
{% if use_bias %}
                                                 {{ name }}_bias,
{% else %}
                                                 NULL,
{% endif %}
                                                 &{{ name }}_output_dims,
                                                 {{ name }}_output);
{% else %}
    arm_cmsis_nn_status result = {{ kernel_fn }}(&input_ctx,
                                                 &output_ctx,
                                                 &svdf_params,
                                                 &input_quant_params,
                                                 &output_quant_params,
                                                 &{{ name }}_input_dims,
                                                 {{ name }}_input_data,
                                                 &{{ name }}_state_dims,
                                                 state_data,
                                                 &{{ name }}_weights_feature_dims,
                                                 {{ name }}_weights_feature,
                                                 &{{ name }}_weights_time_dims,
                                                 {{ name }}_weights_time,
                                                 &{{ name }}_bias_dims,
{% if use_bias %}
                                                 {{ name }}_bias,
{% else %}
                                                 NULL,
{% endif %}
                                                 &{{ name }}_output_dims,
                                                 {{ name }}_output);
{% endif %}

    if (input_ctx.buf) {
        free(input_ctx.buf);
    }
    if (output_ctx.buf) {
        free(output_ctx.buf);
    }
{% if has_ctx %}
    if (ctx.buf) {
        free(ctx.buf);
    }
{% endif %}

    return result;
}

int32_t {{ name }}_test_case_run(void)
{
{% if has_ctx %}
    int32_t buf_dsp = arm_svdf_s8_get_buffer_size_dsp(&{{ name }}_weights_feature_dims);
    int32_t buf_mve = arm_svdf_s8_get_buffer_size_mve(&{{ name }}_weights_feature_dims);
    int32_t buf_any = arm_svdf_s8_get_buffer_size(&{{ name }}_weights_feature_dims);
#if defined(ARM_MATH_MVEI)
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("SVDF") }}", "buffer size", buf_any, buf_mve);
#else
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("SVDF") }}", "buffer size", buf_any, buf_dsp);
#endif
{% endif %}
    int32_t status = run_svdf();
    HELIA_VALIDATE_STATUS("{{ validation_label | default("SVDF") }}", status);

    int failures = 0;
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("EXACT_INT") }},
        {{ name }}_output,
        {{ name }}_output_ref,
        SVDF_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(8) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
