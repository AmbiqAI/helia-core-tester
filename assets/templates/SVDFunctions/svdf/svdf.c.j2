#include "{{ name }}_svdf.h"
#include "arm_nnfunctions.h"
#include <string.h>
{% include "common/standalone/runtime_common.j2" %}

#define SVDF_OUTPUT_SIZE ({{ prefix|upper }}_INPUT_BATCHES * {{ prefix|upper }}_UNIT_COUNT)
static {{ output_dtype }} {{ name }}_output[SVDF_OUTPUT_SIZE];

static int32_t run_svdf(void)
{
    cmsis_nn_svdf_params svdf_params;
    cmsis_nn_per_tensor_quant_params input_quant_params;
    cmsis_nn_per_tensor_quant_params output_quant_params;
    cmsis_nn_context input_ctx;
    cmsis_nn_context output_ctx;
{% if has_ctx %}
    cmsis_nn_context ctx;
{% endif %}

    const int32_t scratch_size = {{ prefix|upper }}_INPUT_BATCHES * {{ prefix|upper }}_FEATURE_BATCHES * sizeof(int32_t);
    const int32_t scratch_size_out = {{ prefix|upper }}_INPUT_BATCHES * {{ prefix|upper }}_UNIT_COUNT * sizeof(int32_t);

    input_ctx.buf = malloc(scratch_size);
    input_ctx.size = scratch_size;
    output_ctx.buf = malloc(scratch_size_out);
    output_ctx.size = scratch_size_out;

{% if has_ctx %}
    const int32_t buf_size = arm_svdf_s8_get_buffer_size(&{{ name }}_weights_feature_dims);
    ctx.buf = buf_size > 0 ? malloc(buf_size) : NULL;
    ctx.size = buf_size;
#if defined(ARM_MATH_MVEI)
    if (ctx.buf != NULL) {
        arm_vector_sum_s8((int32_t *)ctx.buf,
                          {{ prefix|upper }}_INPUT_HEIGHT,
                          {{ prefix|upper }}_FEATURE_BATCHES,
                          {{ name }}_weights_feature,
                          -{{ prefix|upper }}_INPUT_OFFSET,
                          0,
                          NULL);
    }
#endif
{% endif %}

    svdf_params.input_activation.min = {{ prefix|upper }}_INPUT_ACTIVATION_MIN;
    svdf_params.input_activation.max = {{ prefix|upper }}_INPUT_ACTIVATION_MAX;
    svdf_params.output_activation.min = {{ prefix|upper }}_OUTPUT_ACTIVATION_MIN;
    svdf_params.output_activation.max = {{ prefix|upper }}_OUTPUT_ACTIVATION_MAX;
    svdf_params.input_offset = {{ prefix|upper }}_INPUT_OFFSET;
    svdf_params.output_offset = {{ prefix|upper }}_OUTPUT_OFFSET;
    svdf_params.rank = {{ prefix|upper }}_RANK;

    input_quant_params.multiplier = {{ prefix|upper }}_INPUT_MULTIPLIER;
    input_quant_params.shift = {{ prefix|upper }}_INPUT_SHIFT;
    output_quant_params.multiplier = {{ prefix|upper }}_OUTPUT_MULTIPLIER;
    output_quant_params.shift = {{ prefix|upper }}_OUTPUT_SHIFT;

    {{ state_dtype }} state_data[{{ prefix|upper }}_INPUT_BATCHES * {{ prefix|upper }}_FEATURE_BATCHES * {{ prefix|upper }}_TIME_BATCHES];
    memcpy(state_data, {{ name }}_state_init, sizeof({{ name }}_state_init));

    memset({{ name }}_output, 0, sizeof({{ name }}_output));

{% if has_ctx %}
    arm_cmsis_nn_status result = {{ kernel_fn }}(&ctx,
                                                 &input_ctx,
                                                 &output_ctx,
                                                 &svdf_params,
                                                 &input_quant_params,
                                                 &output_quant_params,
                                                 &{{ name }}_input_dims,
                                                 {{ name }}_input_data,
                                                 &{{ name }}_state_dims,
                                                 state_data,
                                                 &{{ name }}_weights_feature_dims,
                                                 {{ name }}_weights_feature,
                                                 &{{ name }}_weights_time_dims,
                                                 {{ name }}_weights_time,
                                                 &{{ name }}_bias_dims,
{% if use_bias %}
                                                 {{ name }}_bias,
{% else %}
                                                 NULL,
{% endif %}
                                                 &{{ name }}_output_dims,
                                                 {{ name }}_output);
{% else %}
    arm_cmsis_nn_status result = {{ kernel_fn }}(&input_ctx,
                                                 &output_ctx,
                                                 &svdf_params,
                                                 &input_quant_params,
                                                 &output_quant_params,
                                                 &{{ name }}_input_dims,
                                                 {{ name }}_input_data,
                                                 &{{ name }}_state_dims,
                                                 state_data,
                                                 &{{ name }}_weights_feature_dims,
                                                 {{ name }}_weights_feature,
                                                 &{{ name }}_weights_time_dims,
                                                 {{ name }}_weights_time,
                                                 &{{ name }}_bias_dims,
{% if use_bias %}
                                                 {{ name }}_bias,
{% else %}
                                                 NULL,
{% endif %}
                                                 &{{ name }}_output_dims,
                                                 {{ name }}_output);
{% endif %}

    if (input_ctx.buf) {
        free(input_ctx.buf);
    }
    if (output_ctx.buf) {
        free(output_ctx.buf);
    }
{% if has_ctx %}
    if (ctx.buf) {
        free(ctx.buf);
    }
{% endif %}

    return result;
}

int32_t {{ prefix }}_{{ name }}_test_case_run(void)
{
{% if has_ctx %}
    int32_t buf_dsp = arm_svdf_s8_get_buffer_size_dsp(&{{ name }}_weights_feature_dims);
    int32_t buf_mve = arm_svdf_s8_get_buffer_size_mve(&{{ name }}_weights_feature_dims);
    int32_t buf_any = arm_svdf_s8_get_buffer_size(&{{ name }}_weights_feature_dims);
#if defined(ARM_MATH_MVEI)
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("SVDF") }}", "buffer size", buf_any, buf_mve);
#else
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("SVDF") }}", "buffer size", buf_any, buf_dsp);
#endif
{% endif %}
    int32_t status = run_svdf();
    HELIA_VALIDATE_STATUS("{{ validation_label | default("SVDF") }}", status);

    int failures = 0;
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("EXACT_INT") }},
        {{ name }}_output,
        {{ name }}_output_ref,
        SVDF_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(8) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
