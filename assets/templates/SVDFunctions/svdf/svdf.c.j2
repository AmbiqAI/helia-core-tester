#include "{{ name }}_svdf.h"
#include "arm_nnfunctions.h"
#include <string.h>
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

#define SVDF_OUTPUT_SIZE ({{ name|upper }}_INPUT_BATCHES * {{ name|upper }}_UNIT_COUNT)
{{ helia_guard_declare(output_dtype, name ~ "_output", "SVDF_OUTPUT_SIZE") }}

/*
 * The scratch contexts below are malloc'd (sized from a runtime buffer-size
 * query), not static arrays, so they can't use helia_guard_declare's
 * #define-the-name trick (issue #68). Instead each allocation grows by
 * 2*HELIA_GUARD_BYTES, the caller-visible ctx.buf points past the head
 * canary, and *_guard_base is kept aside so free() still targets the real
 * malloc'd pointer. Guard breaches accumulate here (run_svdf() itself
 * only returns the kernel's arm_cmsis_nn_status) and are folded into
 * _test_case_run's failures count.
 */
static int {{ name }}_guard_failures;

static int32_t run_svdf(void)
{
    cmsis_nn_svdf_params svdf_params;
    cmsis_nn_per_tensor_quant_params input_quant_params;
    cmsis_nn_per_tensor_quant_params output_quant_params;
    cmsis_nn_context input_ctx;
    cmsis_nn_context output_ctx;
{% if has_ctx %}
    cmsis_nn_context ctx;
{% endif %}

    const int32_t scratch_size = {{ name|upper }}_INPUT_BATCHES * {{ name|upper }}_FEATURE_BATCHES * sizeof(int32_t);
    const int32_t scratch_size_out = {{ name|upper }}_INPUT_BATCHES * {{ name|upper }}_UNIT_COUNT * sizeof(int32_t);

    {{ name }}_guard_failures = 0;

    uint8_t *{{ name }}_input_ctx_guard_base = malloc((size_t)scratch_size + 2u * HELIA_GUARD_BYTES);
    input_ctx.buf = {{ name }}_input_ctx_guard_base ? ({{ name }}_input_ctx_guard_base + HELIA_GUARD_BYTES) : NULL;
    input_ctx.size = scratch_size;
    if ({{ name }}_input_ctx_guard_base) {
        helia_guard_arm({{ name }}_input_ctx_guard_base,
                        {{ name }}_input_ctx_guard_base + HELIA_GUARD_BYTES + scratch_size,
                        input_ctx.buf, (size_t)scratch_size, true /* pure scratch: poison-safe */);
    }

    uint8_t *{{ name }}_output_ctx_guard_base = malloc((size_t)scratch_size_out + 2u * HELIA_GUARD_BYTES);
    output_ctx.buf = {{ name }}_output_ctx_guard_base ? ({{ name }}_output_ctx_guard_base + HELIA_GUARD_BYTES) : NULL;
    output_ctx.size = scratch_size_out;
    if ({{ name }}_output_ctx_guard_base) {
        helia_guard_arm({{ name }}_output_ctx_guard_base,
                        {{ name }}_output_ctx_guard_base + HELIA_GUARD_BYTES + scratch_size_out,
                        output_ctx.buf, (size_t)scratch_size_out, true /* pure scratch: poison-safe */);
    }

{% if has_ctx %}
    const int32_t buf_size = arm_svdf_s8_get_buffer_size(&{{ name }}_weights_feature_dims);
    uint8_t *{{ name }}_ctx_guard_base = buf_size > 0 ? malloc((size_t)buf_size + 2u * HELIA_GUARD_BYTES) : NULL;
    ctx.buf = {{ name }}_ctx_guard_base ? ({{ name }}_ctx_guard_base + HELIA_GUARD_BYTES) : NULL;
    ctx.size = buf_size;
    if ({{ name }}_ctx_guard_base) {
        helia_guard_arm({{ name }}_ctx_guard_base,
                        {{ name }}_ctx_guard_base + HELIA_GUARD_BYTES + buf_size,
                        ctx.buf, (size_t)buf_size, true /* pure scratch: poison-safe */);
    }
#if defined(ARM_MATH_MVEI)
    if (ctx.buf != NULL) {
        arm_vector_sum_s8((int32_t *)ctx.buf,
                          {{ name|upper }}_INPUT_HEIGHT,
                          {{ name|upper }}_FEATURE_BATCHES,
                          {{ name }}_weights_feature,
                          -{{ name|upper }}_INPUT_OFFSET,
                          0,
                          NULL);
    }
#endif
{% endif %}

    svdf_params.input_activation.min = {{ name|upper }}_INPUT_ACTIVATION_MIN;
    svdf_params.input_activation.max = {{ name|upper }}_INPUT_ACTIVATION_MAX;
    svdf_params.output_activation.min = {{ name|upper }}_OUTPUT_ACTIVATION_MIN;
    svdf_params.output_activation.max = {{ name|upper }}_OUTPUT_ACTIVATION_MAX;
    svdf_params.input_offset = {{ name|upper }}_INPUT_OFFSET;
    svdf_params.output_offset = {{ name|upper }}_OUTPUT_OFFSET;
    svdf_params.rank = {{ name|upper }}_RANK;

    input_quant_params.multiplier = {{ name|upper }}_INPUT_MULTIPLIER;
    input_quant_params.shift = {{ name|upper }}_INPUT_SHIFT;
    output_quant_params.multiplier = {{ name|upper }}_OUTPUT_MULTIPLIER;
    output_quant_params.shift = {{ name|upper }}_OUTPUT_SHIFT;

    {{ state_dtype }} state_data[{{ name|upper }}_INPUT_BATCHES * {{ name|upper }}_FEATURE_BATCHES * {{ name|upper }}_TIME_BATCHES];
    memcpy(state_data, {{ name }}_state_init, sizeof({{ name }}_state_init));

    HELIA_GUARD_ARM({{ name }}_output, false /* real output, zero-seeded below: don't poison */);
    memset({{ name }}_output, 0, sizeof({{ name }}_output));

{% if has_ctx %}
    arm_cmsis_nn_status result = {{ kernel_fn }}(&ctx,
                                                 &input_ctx,
                                                 &output_ctx,
                                                 &svdf_params,
                                                 &input_quant_params,
                                                 &output_quant_params,
                                                 &{{ name }}_input_dims,
                                                 {{ name }}_input_data,
                                                 &{{ name }}_state_dims,
                                                 state_data,
                                                 &{{ name }}_weights_feature_dims,
                                                 {{ name }}_weights_feature,
                                                 &{{ name }}_weights_time_dims,
                                                 {{ name }}_weights_time,
                                                 &{{ name }}_bias_dims,
{% if use_bias %}
                                                 {{ name }}_bias,
{% else %}
                                                 NULL,
{% endif %}
                                                 &{{ name }}_output_dims,
                                                 {{ name }}_output);
{% else %}
    arm_cmsis_nn_status result = {{ kernel_fn }}(&input_ctx,
                                                 &output_ctx,
                                                 &svdf_params,
                                                 &input_quant_params,
                                                 &output_quant_params,
                                                 &{{ name }}_input_dims,
                                                 {{ name }}_input_data,
                                                 &{{ name }}_state_dims,
                                                 state_data,
                                                 &{{ name }}_weights_feature_dims,
                                                 {{ name }}_weights_feature,
                                                 &{{ name }}_weights_time_dims,
                                                 {{ name }}_weights_time,
                                                 &{{ name }}_bias_dims,
{% if use_bias %}
                                                 {{ name }}_bias,
{% else %}
                                                 NULL,
{% endif %}
                                                 &{{ name }}_output_dims,
                                                 {{ name }}_output);
{% endif %}

    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("SVDF") }} output", {{ name }}_guard_failures);
    if ({{ name }}_input_ctx_guard_base) {
        helia_guard_check("{{ validation_label | default("SVDF") }} input scratch",
                          {{ name }}_input_ctx_guard_base,
                          {{ name }}_input_ctx_guard_base + HELIA_GUARD_BYTES + scratch_size,
                          &{{ name }}_guard_failures);
        free({{ name }}_input_ctx_guard_base);
    }
    if ({{ name }}_output_ctx_guard_base) {
        helia_guard_check("{{ validation_label | default("SVDF") }} output scratch",
                          {{ name }}_output_ctx_guard_base,
                          {{ name }}_output_ctx_guard_base + HELIA_GUARD_BYTES + scratch_size_out,
                          &{{ name }}_guard_failures);
        free({{ name }}_output_ctx_guard_base);
    }
{% if has_ctx %}
    if ({{ name }}_ctx_guard_base) {
        helia_guard_check("{{ validation_label | default("SVDF") }} ctx",
                          {{ name }}_ctx_guard_base,
                          {{ name }}_ctx_guard_base + HELIA_GUARD_BYTES + buf_size,
                          &{{ name }}_guard_failures);
        free({{ name }}_ctx_guard_base);
    }
{% endif %}

    return result;
}

int32_t {{ name }}_test_case_run(void)
{
{% if has_ctx %}
    int32_t buf_dsp = arm_svdf_s8_get_buffer_size_dsp(&{{ name }}_weights_feature_dims);
    int32_t buf_mve = arm_svdf_s8_get_buffer_size_mve(&{{ name }}_weights_feature_dims);
    int32_t buf_any = arm_svdf_s8_get_buffer_size(&{{ name }}_weights_feature_dims);
#if defined(ARM_MATH_MVEI)
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("SVDF") }}", "buffer size", buf_any, buf_mve);
#else
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("SVDF") }}", "buffer size", buf_any, buf_dsp);
#endif
{% endif %}
    int32_t status = run_svdf();
    HELIA_VALIDATE_STATUS("{{ validation_label | default("SVDF") }}", status);

    int failures = {{ name }}_guard_failures;
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("EXACT_INT") }},
        {{ name }}_output,
        {{ name }}_output_ref,
        SVDF_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(8) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
