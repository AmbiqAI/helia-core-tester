#include "{{ name }}_svdf.h"
#include "arm_nnfunctions.h"
#include <string.h>
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

{# Declare only the buffers this fault mode actually passes to the kernel so a
   NULL-substituted buffer never becomes an unused static (-Wunused-variable). #}
{{ helia_guard_declare(output_dtype, name ~ "_output", name|upper ~ "_INPUT_BATCHES * " ~ name|upper ~ "_UNIT_COUNT") }}
{{ helia_guard_declare(state_dtype, name ~ "_state", name|upper ~ "_INPUT_BATCHES * " ~ name|upper ~ "_FEATURE_BATCHES * " ~ name|upper ~ "_TIME_BATCHES") }}
{% if fault != "null_input_ctx_buf" %}{{ helia_guard_declare("int32_t", name ~ "_scratch_input", name|upper ~ "_INPUT_BATCHES * " ~ name|upper ~ "_FEATURE_BATCHES") }}
{% endif %}{% if fault != "null_output_ctx_buf" %}{{ helia_guard_declare("int32_t", name ~ "_scratch_output", name|upper ~ "_INPUT_BATCHES * " ~ name|upper ~ "_UNIT_COUNT") }}
{% endif %}{% if has_ctx and fault != "null_ctx_buf" %}{{ helia_guard_declare("int32_t", name ~ "_kernel_sums", name|upper ~ "_FEATURE_BATCHES") }}
{% endif %}

/*
 * Fault-injection test case: exercises an {{ kernel_fn }}
 * argument-validation branch. Fault mode: {{ fault }}.
 */
static int32_t run_svdf(void)
{
    const cmsis_nn_context input_ctx = {
        .buf = {% if fault == "null_input_ctx_buf" %}NULL{% else %}(uint8_t *){{ name }}_scratch_input{% endif %},
        .size = {% if fault == "null_input_ctx_buf" %}0{% else %}sizeof({{ name }}_scratch_input){% endif %},
    };
    const cmsis_nn_context output_ctx = {
        .buf = {% if fault == "null_output_ctx_buf" %}NULL{% else %}(uint8_t *){{ name }}_scratch_output{% endif %},
        .size = {% if fault == "null_output_ctx_buf" %}0{% else %}sizeof({{ name }}_scratch_output){% endif %},
    };
{% if has_ctx %}
    const cmsis_nn_context ctx = {
        .buf = {% if fault == "null_ctx_buf" %}NULL{% else %}(uint8_t *){{ name }}_kernel_sums{% endif %},
        .size = {% if fault == "null_ctx_buf" %}0{% else %}sizeof({{ name }}_kernel_sums){% endif %},
    };
{% endif %}
    const cmsis_nn_svdf_params svdf_params = {
        .input_offset = {{ name|upper }}_INPUT_OFFSET,
        .output_offset = {{ name|upper }}_OUTPUT_OFFSET,
        .rank = {{ name|upper }}_RANK,
        .input_activation = {.min = {{ name|upper }}_INPUT_ACTIVATION_MIN, .max = {{ name|upper }}_INPUT_ACTIVATION_MAX},
        .output_activation = {.min = {{ name|upper }}_OUTPUT_ACTIVATION_MIN, .max = {{ name|upper }}_OUTPUT_ACTIVATION_MAX},
    };
    const cmsis_nn_per_tensor_quant_params input_quant_params = {
        .multiplier = {{ name|upper }}_INPUT_MULTIPLIER,
        .shift = {{ name|upper }}_INPUT_SHIFT,
    };
    const cmsis_nn_per_tensor_quant_params output_quant_params = {
        .multiplier = {{ name|upper }}_OUTPUT_MULTIPLIER,
        .shift = {{ name|upper }}_OUTPUT_SHIFT,
    };

    memcpy({{ name }}_state, {{ name }}_state_init, sizeof({{ name }}_state_init));

    return {{ kernel_fn }}(
{% if has_ctx %}
        &ctx,
{% endif %}
        &input_ctx,
        &output_ctx,
        &svdf_params,
        &input_quant_params,
        &output_quant_params,
        &{{ name }}_input_dims,
        {{ name }}_input_data,
        &{{ name }}_state_dims,
        {{ name }}_state,
        &{{ name }}_weights_feature_dims,
        {{ name }}_weights_feature,
        &{{ name }}_weights_time_dims,
        {{ name }}_weights_time,
        &{{ name }}_bias_dims,
{% if use_bias %}
        {{ name }}_bias,
{% else %}
        NULL,
{% endif %}
        &{{ name }}_output_dims,
        {{ name }}_output
    );
}

int32_t {{ name }}_test_case_run(void)
{
    HELIA_GUARD_ARM({{ name }}_output, true /* rejected call must not write it: poison */);
    HELIA_GUARD_ARM({{ name }}_state, false /* seeded inside the run function */);
{% if fault != "null_input_ctx_buf" %}    HELIA_GUARD_ARM({{ name }}_scratch_input, true /* pure scratch: poison-safe */);
{% endif %}{% if fault != "null_output_ctx_buf" %}    HELIA_GUARD_ARM({{ name }}_scratch_output, true /* pure scratch: poison-safe */);
{% endif %}{% if has_ctx and fault != "null_ctx_buf" %}    HELIA_GUARD_ARM({{ name }}_kernel_sums, true /* pure scratch: poison-safe */);
{% endif %}    int32_t status = run_svdf();
    int failures = 0;
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("SVDF") }} output", failures);
{% if expected_status != "ARM_CMSIS_NN_SUCCESS" %}    HELIA_GUARD_CHECK_UNTOUCHED({{ name }}_output, "{{ validation_label | default("SVDF") }} output", failures);
{% endif %}    HELIA_GUARD_CHECK({{ name }}_state, "{{ validation_label | default("SVDF") }} state", failures);
{% if fault != "null_input_ctx_buf" %}    HELIA_GUARD_CHECK({{ name }}_scratch_input, "{{ validation_label | default("SVDF") }} scratch input", failures);
{% endif %}{% if fault != "null_output_ctx_buf" %}    HELIA_GUARD_CHECK({{ name }}_scratch_output, "{{ validation_label | default("SVDF") }} scratch output", failures);
{% endif %}{% if has_ctx and fault != "null_ctx_buf" %}    HELIA_GUARD_CHECK({{ name }}_kernel_sums, "{{ validation_label | default("SVDF") }} kernel sums", failures);
{% endif %}    HELIA_VALIDATE_EXPECTED_STATUS(
        "{{ validation_label | default("SVDF") }}",
        status,
        {{ expected_status }}
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

