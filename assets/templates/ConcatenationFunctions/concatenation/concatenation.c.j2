#include "{{ name }}_concatenation.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
static {{ output_dtype }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];

// Array of input pointers
static const {{ input_dtype }}* {{ name }}_input_ptrs[] = {
{% for i in range(num_inputs) %}
    {{ name }}_input{{ i + 1 }}{% if not loop.last %},{% endif %}
{% endfor %}
};

int32_t {{ prefix }}_{{ name }}_run(
    const {{ input_dtype }}* const *input_ptrs,
    {{ output_dtype }}* __restrict output
) {
    // Call Concatenation kernel
    arm_cmsis_nn_status kernel_status = ARM_CMSIS_NN_SUCCESS;
{% if call_style and call_style|lower == 'axis_x' %}
    for (int i = 0; i < {{ num_inputs }}; i++) {
        {{ kernel_fn }}(
            input_ptrs[i],
            (uint16_t){{ name }}_input_x[i],
            (uint16_t){{ name }}_input_y[i],
            (uint16_t){{ name }}_input_z[i],
            (uint16_t){{ name }}_input_w[i],
            output,
            (uint16_t){{ output_x }},
            (uint32_t){{ name }}_offsets[i]
        );
    }
{% elif call_style and call_style|lower == 'axis_y' %}
    for (int i = 0; i < {{ num_inputs }}; i++) {
        {{ kernel_fn }}(
            input_ptrs[i],
            (uint16_t){{ name }}_input_x[i],
            (uint16_t){{ name }}_input_y[i],
            (uint16_t){{ name }}_input_z[i],
            (uint16_t){{ name }}_input_w[i],
            output,
            (uint16_t){{ output_y }},
            (uint32_t){{ name }}_offsets[i]
        );
    }
{% elif call_style and call_style|lower == 'axis_z' %}
    for (int i = 0; i < {{ num_inputs }}; i++) {
        {{ kernel_fn }}(
            input_ptrs[i],
            (uint16_t){{ name }}_input_x[i],
            (uint16_t){{ name }}_input_y[i],
            (uint16_t){{ name }}_input_z[i],
            (uint16_t){{ name }}_input_w[i],
            output,
            (uint16_t){{ output_z }},
            (uint32_t){{ name }}_offsets[i]
        );
    }
{% elif call_style and call_style|lower == 'axis_w' %}
    for (int i = 0; i < {{ num_inputs }}; i++) {
        {{ kernel_fn }}(
            input_ptrs[i],
            (uint16_t){{ name }}_input_x[i],
            (uint16_t){{ name }}_input_y[i],
            (uint16_t){{ name }}_input_z[i],
            (uint16_t){{ name }}_input_w[i],
            output,
            (uint32_t){{ name }}_offsets[i]
        );
    }
{% else %}
    kernel_status = {{ kernel_fn }}(
        input_ptrs,
        {{ num_inputs }},                      // inputs_count
        {{ name }}_input_concat_dims,          // input_concat_dims
        {{ axis }},                           // axis
        output,                               // output_data
        {{ output_rank }},  // output_dims (number of dimensions)
        {{ name }}_output_shape               // output_shape
    );
{% endif %}
    
    return kernel_status;
}

int32_t {{ prefix }}_{{ name }}_test_case_run(void)
{
    int32_t status = {{ prefix }}_{{ name }}_run({{ name }}_input_ptrs, {{ name }}_output);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Concatenation") }}", status);

    int failures = 0;
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("TOLERANT_INT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
