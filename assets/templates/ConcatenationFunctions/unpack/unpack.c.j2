#include "{{ name }}_unpack.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

{% for out in outputs %}
#define {{ out.name|upper }}_OUTPUT_SIZE ({{ out.size }})
{% if out.size > 0 %}
{{ helia_guard_declare(output_dtype, out.name ~ "_output", out.name|upper ~ "_OUTPUT_SIZE") }}
{% else %}
// zero-element slice: storage only, nothing is compared
{{ helia_guard_declare(output_dtype, out.name ~ "_output", 1) }}
{% endif %}
{% endfor %}

static {{ output_dtype }}* {{ name }}_output_ptrs[] = {
{% for out in outputs %}
    {{ out.name }}_output,
{% endfor %}
};

int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input
) {
    // Call Unpack kernel: one output per slice along the axis
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        input,                    // input_data
        {{ input_dims_count }},   // input_dims
        {{ name }}_input_shape,   // input_shape
        {{ axis }},               // axis
        {{ name }}_output_ptrs    // output_data (array of pointers)
    );

    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
{% for out in outputs %}
{% if out.size > 0 %}
    HELIA_GUARD_ARM({{ out.name }}_output, false /* real output, not scratch: don't poison */);
{% else %}
    HELIA_GUARD_ARM({{ out.name }}_output, true /* zero-extent slice must not be written: poison */);
{% endif %}
{% endfor %}
    int32_t status = {{ name }}_run({{ name }}_input);
    int failures = 0;
{% for out in outputs %}
    HELIA_GUARD_CHECK({{ out.name }}_output, "{{ validation_label | default("Unpack") }} {{ out.name }} output", failures);
{% if out.size == 0 %}
    HELIA_GUARD_CHECK_UNTOUCHED({{ out.name }}_output, "{{ validation_label | default("Unpack") }} {{ out.name }} output", failures);
{% endif %}
{% endfor %}
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Unpack") }}", status);

{% for out in outputs %}
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("FLOAT") }},
        {{ out.name }}_output,
        {{ out.name }}_expected_output,
        {{ out.name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
{% endfor %}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
