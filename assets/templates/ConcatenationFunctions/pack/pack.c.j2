#include "{{ name }}_pack.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/validation.j2" import validation_outputs with context %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_size }})
static {{ output_dtype }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];

// Array of input pointers
static const {{ input_dtype }}* {{ name }}_input_ptrs[] = {
{% for i in range(num_inputs) %}
    {{ name }}_input{{ i + 1 }},
{% endfor %}
};

int32_t {{ name }}_run(
    const {{ input_dtype }}* const *input_ptrs,
    {{ output_dtype }}* __restrict output
) {
    // Call Pack kernel
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        input_ptrs,               // input_data
        {{ num_inputs }},         // num_inputs
        {{ input_dims_count }},   // input_dims
{% if input_dims_count > 0 %}
        {{ name }}_input_shape,   // input_shape
{% else %}
        NULL,                     // input_shape (rank-0 inputs)
{% endif %}
        {{ axis }},               // axis
        output                    // output_data
    );

    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
    int32_t status = {{ name }}_run({{ name }}_input_ptrs, {{ name }}_output);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Pack") }}", status);

    int failures = 0;
{{ validation_outputs(validation_mode_token | default("FLOAT"), validation_tolerance | default(1)) }}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
