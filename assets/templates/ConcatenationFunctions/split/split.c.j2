#include "{{ name }}_split.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}

{% for out in outputs %}
#define {{ out.name|upper }}_OUTPUT_SIZE ({{ out.size }})
static {{ output_dtype }} {{ out.name }}_output[{{ out.name|upper }}_OUTPUT_SIZE];
{% endfor %}

static {{ output_dtype }}* {{ name }}_output_ptrs[] = {
    {% for out in outputs %}
    {{ out.name }}_output,
    {% endfor %}
};

int32_t {{ prefix }}_{{ name }}_run(
    const {{ input_dtype }}* __restrict input
) {
    // Call Split kernel
    // Note: Split has multiple outputs, but we only handle the first one for now
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        input,                              // input_data
        {{ input_dims_count }},             // input_dims
        {{ name }}_input_shape,             // input_shape
        {{ axis }},                         // axis
        {{ num_splits }},                   // num_splits
        {{ name }}_split_dims,              // split_dims
        {{ name }}_output_ptrs              // output_data (array of pointers)
    );
    
    return kernel_status;
}

int32_t {{ prefix }}_{{ name }}_test_case_run(void)
{
    const arm_cmsis_nn_status expected = ARM_CMSIS_NN_SUCCESS;
    int32_t status = {{ prefix }}_{{ name }}_run({{ name }}_input);
    if (status != expected) {
        printf("Split failed with status %d\r\n", (int)status);
        printf("1 Failures\r\n");
        return 1;
    }

    int failures = 0;
    {% for out in outputs %}
    {
        const int output_size = {{ out.name|upper }}_OUTPUT_SIZE;
        const {{ output_dtype }} *act = {{ out.name }}_output;
        const {{ output_dtype }} *exp = {{ out.name }}_expected_output;
        for (int i = 0; i < output_size; i++) {
            int act_val = (int)act[i];
            int exp_val = (int)exp[i];
            int diff = act_val - exp_val;
            if (diff < 0) diff = -diff;  // absolute difference
            if (diff > 1) {  // Allow tolerance of 1 bit difference
                failures++;
                if (failures <= 20) {
                    printf("Mismatch[%d]: exp=%d got=%d (diff=%d)\r\n", i, exp_val, act_val, diff);
                }
            }
        }
    }
    {% endfor %}

    printf("%d Failures\r\n", failures);
    return failures;
}

{% include "common/standalone/main.j2" %}
