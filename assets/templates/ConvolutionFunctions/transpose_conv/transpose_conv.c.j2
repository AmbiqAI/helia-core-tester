#include "{{ name }}_transpose_conv.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}

// Context for buffer allocation
static cmsis_nn_context {{ name }}_ctx;

// Runtime scratch buffer (max upper bound; actual size queried at runtime)
// Buffer size calculated conservatively to handle MVE and DSP implementations
#define {{ name|upper }}_BUFFER_SIZE_MAX {{ buffer_size_max }}
static uint8_t {{ name }}_buffer[{{ name|upper }}_BUFFER_SIZE_MAX];

// Reverse convolution context buffer (output_ctx parameter in arm_transpose_conv_wrapper_s8)
// Size: output width * output height * output channel * 4
#define {{ name|upper }}_REVERSE_CONV_CTX_SIZE {{ reverse_conv_ctx_size }}
static uint8_t {{ name }}_reverse_conv_ctx_buffer[{{ name|upper }}_REVERSE_CONV_CTX_SIZE];
static cmsis_nn_context {{ name }}_reverse_conv_ctx;

{% if has_weight_sum %}
// Weight sum context for s8 transpose convolutions (matches CMSIS-NN test approach)
static cmsis_nn_context {{ name }}_weight_sum_ctx;
// Weight sum buffer size: output_dims.c * sizeof(int32_t) (matches arm_convolve_s8_get_weights_sum_size)
#define {{ name|upper }}_WEIGHT_SUM_BUFFER_SIZE ({{ output_dims.c }} * sizeof(int32_t))
static uint8_t {{ name }}_weight_sum_buffer[{{ name|upper }}_WEIGHT_SUM_BUFFER_SIZE];
{% endif %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
static {{ output_dtype }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];

int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    // Calculate required buffer size
    {% if float_kernel %}
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        &{{ name }}_transpose_conv_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims
    );
    int32_t reverse_required_buffer_size = {{ kernel_get_reverse_buffer_size_fn }}(
        &{{ name }}_transpose_conv_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims
    );
    {% else %}
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        &{{ name }}_transpose_conv_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims
    );
    int32_t reverse_required_buffer_size = arm_transpose_conv_s8_get_reverse_conv_buffer_size(
        &{{ name }}_transpose_conv_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims
    );
    {% endif %}

{% if expected_buffer_size is defined and expected_buffer_size is not none %}
    // Exact scratch size (issue #69): asserted against a value measured independently
    // from calculate_transpose_conv_buffer_size_max's static-allocation upper bound --
    // see {{ kernel_get_buffer_size_fn }}() in the ns-cmsis-nn checkout.
    {% if expected_buffer_size is mapping %}
#if defined(ARM_MATH_MVEI)
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Transpose convolution") }}", "buffer size", {{ expected_buffer_size.mve }}, required_buffer_size);
#elif defined(ARM_MATH_DSP)
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Transpose convolution") }}", "buffer size", {{ expected_buffer_size.dsp }}, required_buffer_size);
#else
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Transpose convolution") }}", "buffer size", {{ expected_buffer_size.generic }}, required_buffer_size);
#endif
    {% else %}
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Transpose convolution") }}", "buffer size", {{ expected_buffer_size }}, required_buffer_size);
    {% endif %}
{% endif %}
{% if expected_reverse_buffer_size is defined and expected_reverse_buffer_size is not none %}
    // Exact reverse-conv scratch size (issue #69), same rationale as above -- see
    // {{ kernel_get_reverse_buffer_size_fn | default("arm_transpose_conv_s8_get_reverse_conv_buffer_size") }}().
    {% if expected_reverse_buffer_size is mapping %}
#if defined(ARM_MATH_MVEI)
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Transpose convolution") }}", "reverse buffer size", {{ expected_reverse_buffer_size.mve }}, reverse_required_buffer_size);
#elif defined(ARM_MATH_DSP)
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Transpose convolution") }}", "reverse buffer size", {{ expected_reverse_buffer_size.dsp }}, reverse_required_buffer_size);
#else
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Transpose convolution") }}", "reverse buffer size", {{ expected_reverse_buffer_size.generic }}, reverse_required_buffer_size);
#endif
    {% else %}
    HELIA_VALIDATE_SCALAR_EQ_INT("{{ validation_label | default("Transpose convolution") }}", "reverse buffer size", {{ expected_reverse_buffer_size }}, reverse_required_buffer_size);
    {% endif %}
{% endif %}

    if (required_buffer_size > {{ name|upper }}_BUFFER_SIZE_MAX) {
        printf("Buffer size error: required=%d > max=%d\r\n", required_buffer_size, {{ name|upper }}_BUFFER_SIZE_MAX);
        return ARM_CMSIS_NN_ARG_ERROR;
    }
    if (reverse_required_buffer_size > {{ name|upper }}_REVERSE_CONV_CTX_SIZE) {
        printf("Reverse buffer size error: required=%d > max=%d\r\n",
               reverse_required_buffer_size,
               {{ name|upper }}_REVERSE_CONV_CTX_SIZE);
        return ARM_CMSIS_NN_ARG_ERROR;
    }

    // Initialize context buffer
    {{ name }}_ctx.buf = {{ name }}_buffer;
    {{ name }}_ctx.size = required_buffer_size;

    // Initialize reverse convolution context buffer (output_ctx parameter)
    {{ name }}_reverse_conv_ctx.buf = {{ name }}_reverse_conv_ctx_buffer;
    {{ name }}_reverse_conv_ctx.size = {{ name|upper }}_REVERSE_CONV_CTX_SIZE;

    {% if has_weight_sum %}
    // Initialize weight sum context and compute weight_sum (matches CMSIS-NN test approach)
    {{ name }}_weight_sum_ctx.buf = {{ name }}_weight_sum_buffer;
    {{ name }}_weight_sum_ctx.size = {{ name|upper }}_WEIGHT_SUM_BUFFER_SIZE;
    
    // Compute weight_sum using arm_convolve_weight_sum (matches CMSIS-NN test_arm_transpose_conv_s8.c)
    int32_t lhs_offset = {{ name }}_transpose_conv_params.input_offset;
    arm_convolve_weight_sum(
        (int32_t *){{ name }}_weight_sum_ctx.buf,
        {{ name }}_weights,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims,
        lhs_offset,
        {% if has_biases %}
        {{ name }}_biases
        {% else %}
        NULL
        {% endif %}
    );
    {% endif %}

    // Call transpose convolution kernel
    {% if float_kernel %}
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_ctx,
        &{{ name }}_reverse_conv_ctx,
        &{{ name }}_transpose_conv_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        {{ name }}_weights,
        &{{ name }}_bias_dims,
        {% if has_biases %}
        {{ name }}_biases,
        {% else %}
        NULL,
        {% endif %}
        &{{ name }}_output_dims,
        output,
        {{ kernel_layout }}
    );
    {% else %}
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_ctx,
        {% if has_weight_sum %}
        &{{ name }}_weight_sum_ctx,
        {% else %}
        NULL,
        {% endif %}
        &{{ name }}_reverse_conv_ctx,
        &{{ name }}_transpose_conv_params,
        &{{ name }}_quant_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        {{ name }}_weights,
        &{{ name }}_bias_dims,
        {% if has_biases %}
        {{ name }}_biases,
        {% else %}
        NULL,
        {% endif %}
        &{{ name }}_output_dims,
        output
    );
    {% endif %}
    
    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
    int32_t status = {{ name }}_run({{ name }}_input, {{ name }}_output);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Transpose convolution") }}", status);

    int failures = 0;
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("TOLERANT_INT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
