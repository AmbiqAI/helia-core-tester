#include "{{ name }}_convolve.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}
{% from "common/standalone/validation.j2" import validation_outputs with context %}

{% include "common/standalone/benchmark.j2" %}

{% set supports_benchmark = true %}

// The kernel this harness links must have the prototype the ns-cmsis-nn export records.
{{ contract_parity_assert(kernel_fn) }}

// Context for buffer allocation
static cmsis_nn_context {{ name }}_ctx;

// Runtime scratch buffer (max upper bound; actual size queried at runtime)
// Buffer size calculated conservatively to handle MVE and DSP implementations
#define {{ name|upper }}_BUFFER_SIZE_MAX {{ buffer_size_max }}
{{ helia_guard_declare("uint8_t", name ~ "_buffer", name|upper ~ "_BUFFER_SIZE_MAX") }}

{% if kernel_fn == 'arm_convolve_wrapper_s8' %}
// Weight sum context (precomputed input-offset/bias fold, avoids per-MAC offset arithmetic)
static cmsis_nn_context {{ name }}_weight_sum_ctx;
// Weight sum buffer size: output channels * sizeof(int32_t)
// CMSIS-NN uses output_dims->c, which should equal filter_dims.n (output channels)
#define {{ name|upper }}_WEIGHT_SUM_BUFFER_SIZE ({{ output_dims.c }} * sizeof(int32_t))
{{ helia_guard_declare("uint8_t", name ~ "_weight_sum_buffer", name|upper ~ "_WEIGHT_SUM_BUFFER_SIZE") }}
{% endif %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
{{ helia_guard_declare(output_dtype, name ~ "_output", name|upper ~ "_OUTPUT_SIZE") }}

{% if has_biases %}
// Bias dimensions
static const cmsis_nn_dims {{ name }}_bias_dims = {
    .n = 0, .h = 0, .w = 0, .c = {{ filter_dims.n }}
};
{% if float_kernel %}
{% elif kernel_fn == 'arm_convolve_wrapper_s16' %}
// s16 requires cmsis_nn_bias_data struct wrapper
static const cmsis_nn_bias_data {{ name }}_bias_data = {
    .data = {{ name }}_biases,
    .is_int32_bias = {% if bias_dtype == 'int32_t' %}true{% else %}false{% endif %}
};
{% endif %}
{% endif %}

{#
  Shared logic for both the plain correctness path ({{name}}_run,
  used by _test_case_run) and the --benchmark path ({{name}}_bench_init /
  {{name}}_bench_op, used by _benchmark_run). Defined once as macros so the
  two paths can never drift out of sync -- only the timing boundary differs
  (init vs. the timed kernel call), not the logic itself.
#}
{% macro conv_bench_init() %}
    // Calculate required buffer size
    {% if float_kernel %}
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        &{{ name }}_conv_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims{% if buffer_size_needs_layout %},
        {{ kernel_layout }}
        {% endif %}
    );
    {% else %}
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        &{{ name }}_conv_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims
    );
    {% endif %}
    // Armed before the capacity check below: an early return there would otherwise leave
    // these canaries unstamped, and the unconditional check in _test_case_run would
    // report a fabricated breach instead of the real sizer error (#68).
    HELIA_GUARD_ARM({{ name }}_buffer, true /* pure scratch: poison to catch read-before-write */);
    {% if kernel_fn == 'arm_convolve_wrapper_s8' %}
    HELIA_GUARD_ARM({{ name }}_weight_sum_buffer, true /* fully recomputed below: poison-safe */);
    {% endif %}
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, 0u);
    // The slack is stamped as wholly unused here so that an early return from the
    // capacity check below leaves every canary in a checked state; it is re-stamped
    // with the real size once the context is populated (#68).


    // The sizer's answer is checked before it becomes a context size (#133). A negative
    // answer is the documented out-of-range sentinel and never a usable size; an answer
    // above this case's static means our generation-time bound and the shipped kernel
    // disagree. They are separate failures because they have separate owners.
    HELIA_VALIDATE_SIZER("{{ kernel_get_buffer_size_fn }}", required_buffer_size);
    HELIA_VALIDATE_SIZER_FITS("{{ kernel_get_buffer_size_fn }}", required_buffer_size, {{ name|upper }}_BUFFER_SIZE_MAX);

    // Initialize context buffer
    {{ name }}_ctx.buf = {{ name }}_buffer;
    {{ name }}_ctx.size = required_buffer_size;
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u);

    {% if kernel_fn == 'arm_convolve_wrapper_s8' %}
    // Initialize weight sum context and buffer
    {{ name }}_weight_sum_ctx.buf = {{ name }}_weight_sum_buffer;
    {{ name }}_weight_sum_ctx.size = {{ name|upper }}_WEIGHT_SUM_BUFFER_SIZE;

    // Calculate weight sum (required for s8 convolutions)
    // This pre-computes weight * input_offset + bias for optimization
    int32_t lhs_offset = (int32_t){{ name }}_conv_params.input_offset;
    {% if has_biases %}
    arm_convolve_weight_sum((int32_t*){{ name }}_weight_sum_ctx.buf,
                            {{ name }}_weights,
                            &{{ name }}_input_dims,
                            &{{ name }}_filter_dims,
                            &{{ name }}_output_dims,
                            lhs_offset,
                            {{ name }}_biases);
    {% else %}
    arm_convolve_weight_sum((int32_t*){{ name }}_weight_sum_ctx.buf,
                            {{ name }}_weights,
                            &{{ name }}_input_dims,
                            &{{ name }}_filter_dims,
                            &{{ name }}_output_dims,
                            lhs_offset,
                            NULL);
    {% endif %}
    {% endif %}
{% endmacro %}
{% macro conv_kernel_call(input_expr, output_expr) %}
    {#
      The argument list is rendered from the kernel contract export in prototype order
      (contract_call): the template names what it passes, the contract decides the order
      and refuses a missing or unknown argument, and the file-scope parity assert above
      makes a header that drifts from the export a compile error rather than a wrong call.
    #}
    {% set conv_args = {
        'ctx': '&' ~ name ~ '_ctx',
        'conv_params': '&' ~ name ~ '_conv_params',
        'input_dims': '&' ~ name ~ '_input_dims',
        'input_data': input_expr,
        'filter_dims': '&' ~ name ~ '_filter_dims',
        'filter_data': name ~ '_weights',
        'bias_dims': ('&' ~ name ~ '_bias_dims') if has_biases else 'NULL',
        'bias_data': (('&' ~ name ~ '_bias_data') if kernel_fn == 'arm_convolve_wrapper_s16' else (name ~ '_biases')) if has_biases else 'NULL',
        'output_dims': '&' ~ name ~ '_output_dims',
        'output_data': output_expr,
    } %}
    {% if kernel_fn == 'arm_convolve_wrapper_s8' %}
    {% set _ = conv_args.update({'weight_sum_ctx': '&' ~ name ~ '_weight_sum_ctx'}) %}
    {% endif %}
    {% if not float_kernel %}
    {% set _ = conv_args.update({'quant_params': '&' ~ name ~ '_quant_params'}) %}
    {% endif %}
    {% if kernel_needs_layout %}
    {% set _ = conv_args.update({'layout': kernel_layout}) %}
    {% endif %}
    return {{ contract_call(kernel_fn, conv_args) }};
{% endmacro %}
int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    {{ conv_bench_init() }}
    {{ conv_kernel_call('input', 'output') }}
}

#ifdef HELIA_BENCHMARK_MODE
// --benchmark support: {{name}}_bench_init() is the one-time buffer/context/
// weight-sum setup (untimed); {{name}}_bench_op() is *only* the kernel call
// (timed, 3 warmup + 10 measured runs by default -- see common/standalone/benchmark.j2).
{% if use_batch_harness %}
// Non-static: HELIA_BATCH_BENCHMARK links every generated test's .c file into a
// single executable (see scripts/gen_batch_harness.py), so a shared
// batch_runner.c calls these via plain extern declarations instead of each
// test carrying its own main(). Function names are unique per test (prefixed
// by {{name}}), so no separate header wiring is needed.
int32_t {{ name }}_bench_init(void)
{% else %}
static int32_t {{ name }}_bench_init(void)
{% endif %}
{
    {{ conv_bench_init() }}
    return ARM_CMSIS_NN_SUCCESS;
}

{% if use_batch_harness %}
int32_t {{ name }}_bench_op(void)
{% else %}
static int32_t {{ name }}_bench_op(void)
{% endif %}
{
    {{ conv_kernel_call(name ~ '_input', name ~ '_output') }}
}

{% if not use_batch_harness %}
static int32_t {{ name }}_benchmark_run(void)
{
    // A sizer check inside _bench_init() returns before the context is populated, so the
    // benchmark must not proceed on that path: _bench_op() would call the kernel with an
    // uninitialised context and time whatever happened, recording cycle counts that mean
    // nothing, or crash. The failing check has already printed its marker naming the
    // sizer (#133); the case fails without timing anything. A kernel call that does not
    // succeed fails it too (helia_benchmark_run stops there), so no cycle count is
    // reported for a call that did not do its work.
    const int32_t init_status = {{ name }}_bench_init();
    if (init_status != ARM_CMSIS_NN_SUCCESS) {
        HELIA_BENCH_PRINTF("[BENCH] {{ name }} skipped: scratch sizer rejected before the context was populated\r\n");
        return helia_benchmark_failed("{{ name }} benchmark init", init_status);
    }
    return helia_benchmark_run("{{ name }}", {{ name }}_bench_op);
}
{% endif %}
#endif // HELIA_BENCHMARK_MODE

int32_t {{ name }}_test_case_run(void)
{
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    int32_t status = {{ name }}_run({{ name }}_input, {{ name }}_output);
    int failures = 0;
    HELIA_GUARD_CHECK({{ name }}_buffer, "{{ validation_label | default("Convolution") }} scratch", failures);
    HELIA_GUARD_CHECK_SLACK({{ name }}_buffer, "{{ validation_label | default("Convolution") }} scratch slack", {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u, failures);
    {% if kernel_fn == 'arm_convolve_wrapper_s8' %}
    HELIA_GUARD_CHECK({{ name }}_weight_sum_buffer, "{{ validation_label | default("Convolution") }} weight_sum", failures);
    {% endif %}
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("Convolution") }} output", failures);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Convolution") }}", status);

{{ validation_outputs(validation_mode_token | default("TOLERANT_INT"), validation_tolerance | default(1)) }}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
