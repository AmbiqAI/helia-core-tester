#include "{{ name }}_depthwise_conv.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}
{% from "common/standalone/validation.j2" import validation_outputs with context %}

// The kernel this harness links must have the prototype the ns-cmsis-nn export records.
{{ contract_parity_assert(kernel_fn) }}

// Context for buffer allocation
static cmsis_nn_context {{ name }}_ctx;

// Runtime scratch buffer (max upper bound; actual size queried at runtime)
// Buffer size calculated conservatively to handle MVE and DSP implementations
#define {{ name|upper }}_BUFFER_SIZE_MAX {{ buffer_size_max }}
{{ helia_guard_declare("uint8_t", name ~ "_buffer", name|upper ~ "_BUFFER_SIZE_MAX") }}

{% if takes_weight_sum_ctx and has_weight_sum %}
// Weight sum context for s8 depthwise wrappers
static cmsis_nn_context {{ name }}_weight_sum_ctx;
{{ helia_guard_declare("int32_t", name ~ "_weight_sum_runtime", output_dims.c) }}
{% endif %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
{{ helia_guard_declare(output_dtype, name ~ "_output", name|upper ~ "_OUTPUT_SIZE") }}

// Bias dimensions: bias shape is [1, 1, 1, C_OUT]
static const cmsis_nn_dims {{ name }}_bias_dims = {
    .n = 1, .h = 1,
    .w = 1, .c = {{ output_dims.c }}
};

int32_t {{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    
    {#
      The scratch query and the kernel call are bound from pools of every value this harness
      can supply (contract_bind): the contract picks and orders the ones each prototype takes
      and refuses one it cannot supply, so any public depthwise entry renders here.
    #}
    {% set sizer_pool = {
        'dw_conv_params': '&' ~ name ~ '_dw_conv_params',
        'input_dims': '&' ~ name ~ '_input_dims',
        'filter_dims': '&' ~ name ~ '_filter_dims',
        'output_dims': '&' ~ name ~ '_output_dims',
        'layout': kernel_layout | default('ARM_NN_LAYOUT_NHWC'),
    } %}
    {% if kernel_get_buffer_size_fn %}
    // Calculate required buffer size
    int32_t required_buffer_size = {{ contract_bind(kernel_get_buffer_size_fn, sizer_pool) }};
    {% else %}
    // The entry takes no scratch query (entry_scratch in the descriptor).
    int32_t required_buffer_size = {{ entry_scratch_bytes }};
    {% endif %}
    // Armed before the capacity check below: an early return there would otherwise leave
    // these canaries unstamped, and the unconditional check in _test_case_run would
    // report a fabricated breach instead of the real sizer error (#68).
    HELIA_GUARD_ARM({{ name }}_buffer, true /* pure scratch: poison to catch read-before-write */);
    {% if takes_weight_sum_ctx and has_weight_sum %}
    HELIA_GUARD_ARM({{ name }}_weight_sum_runtime, true /* fully recomputed below: poison-safe */);
    {% endif %}
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, 0u);
    // The slack is stamped as wholly unused here so that an early return from the
    // capacity check below leaves every canary in a checked state; it is re-stamped
    // with the real size once the context is populated (#68).


    // The sizer's answer is checked before it becomes a context size (#133). A negative
    // answer is the documented out-of-range sentinel and never a usable size; an answer
    // above this case's static means our generation-time bound and the shipped kernel
    // disagree. They are separate failures because they have separate owners.
    {% if kernel_get_buffer_size_fn %}
    HELIA_VALIDATE_SIZER("{{ kernel_get_buffer_size_fn }}", required_buffer_size);
    HELIA_VALIDATE_SIZER_FITS("{{ kernel_get_buffer_size_fn }}", required_buffer_size, {{ name|upper }}_BUFFER_SIZE_MAX);
    {% endif %}

    // Initialize context buffer
    // Armed unconditionally: force_no_scratch bypasses {{ name }}_buffer entirely,
    // but guarding/poisoning it here regardless is harmless either way.
    {% if force_no_scratch | default(false) %}
    {{ name }}_ctx.buf = NULL;
    {{ name }}_ctx.size = 0;
    {% else %}
    {{ name }}_ctx.buf = {{ name }}_buffer;
    {{ name }}_ctx.size = required_buffer_size;
    {% endif %}
    HELIA_GUARD_STAMP_SLACK({{ name }}_buffer, {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u);

    {% if takes_weight_sum_ctx and has_weight_sum %}
    // Compute weight sums at runtime when supported; fallback to precomputed values.
    arm_cmsis_nn_status weight_sum_status = arm_depthwise_convolve_weight_sum(
        {{ name }}_weight_sum_runtime,
        NULL,
        {{ name }}_weights,
        &{{ name }}_dw_conv_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims,
        {{ name }}_dw_conv_params.input_offset,
        {% if has_biases %}
        {{ name }}_biases
        {% else %}
        NULL
        {% endif %}
    );
    if (weight_sum_status == ARM_CMSIS_NN_SUCCESS) {
        {{ name }}_weight_sum_ctx.buf = (uint8_t *){{ name }}_weight_sum_runtime;
    } else {
        {{ name }}_weight_sum_ctx.buf = (uint8_t *){{ name }}_weight_sum;
    }
    {{ name }}_weight_sum_ctx.size = {{ output_dims.c }} * sizeof(int32_t);
    {% endif %}

    // Call depthwise convolution kernel
    {% set bias_type = contract_param_type(kernel_fn, 'bias_data') %}
    {% set dw_pool = {
        'ctx': '&' ~ name ~ '_ctx',
        'dw_conv_params': '&' ~ name ~ '_dw_conv_params',
        'input_dims': '&' ~ name ~ '_input_dims',
        'input_data': 'input',
        'filter_dims': '&' ~ name ~ '_filter_dims',
        'filter_data': name ~ '_weights',
        'bias_dims': '&' ~ name ~ '_bias_dims',
        'bias_data': (('(const int64_t*)' if 'int64_t' in bias_type else '') ~ name ~ '_biases') if has_biases else 'NULL',
        'output_dims': '&' ~ name ~ '_output_dims',
        'output_data': 'output',
        'layout': kernel_layout | default('ARM_NN_LAYOUT_NHWC'),
    } %}
    {% if takes_weight_sum_ctx and has_weight_sum %}
    {% set _ = dw_pool.update({'weight_sum_ctx': '&' ~ name ~ '_weight_sum_ctx'}) %}
    {% endif %}
    {% if not float_kernel %}
    {% set _ = dw_pool.update({'quant_params': '&' ~ name ~ '_quant_params'}) %}
    {% endif %}
    arm_cmsis_nn_status kernel_status = {{ contract_bind(kernel_fn, dw_pool, indent='        ') }};

    return kernel_status;
}

int32_t {{ name }}_test_case_run(void)
{
    {% if expected_status | default("ARM_CMSIS_NN_SUCCESS") != "ARM_CMSIS_NN_SUCCESS" %}
    HELIA_GUARD_ARM({{ name }}_output, true /* a declined call must not write it: poison */);
    {% else %}
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    {% endif %}
    int32_t status = {{ name }}_run({{ name }}_input, {{ name }}_output);
    int failures = 0;
    {% if planar_supported is defined and planar_supported is not none %}
    int32_t planar_supported = {{ planar_rule_fn }}(
        &{{ name }}_dw_conv_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims
    );
    if (planar_supported != {{ 1 if planar_supported else 0 }}) {
        printf("{{ planar_rule_fn }} returned %ld, expected {{ 1 if planar_supported else 0 }}\r\n", (long)planar_supported);
        ++failures;
    }
    {% endif %}
    HELIA_GUARD_CHECK({{ name }}_buffer, "{{ validation_label | default("Depthwise convolution") }} scratch", failures);
    HELIA_GUARD_CHECK_SLACK({{ name }}_buffer, "{{ validation_label | default("Depthwise convolution") }} scratch slack", {{ name }}_ctx.buf == {{ name }}_buffer ? (size_t){{ name }}_ctx.size : 0u, failures);
    {% if takes_weight_sum_ctx and has_weight_sum %}
    HELIA_GUARD_CHECK({{ name }}_weight_sum_runtime, "{{ validation_label | default("Depthwise convolution") }} weight_sum", failures);
    {% endif %}
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("Depthwise convolution") }} output", failures);
    {% if expected_status | default("ARM_CMSIS_NN_SUCCESS") != "ARM_CMSIS_NN_SUCCESS" %}
    HELIA_GUARD_CHECK_UNTOUCHED({{ name }}_output, "{{ validation_label | default("Depthwise convolution") }} output", failures);
    HELIA_VALIDATE_EXPECTED_STATUS(
        "{{ validation_label | default("Depthwise convolution") }}",
        status,
        {{ expected_status }}
    );
    {% else %}
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Depthwise convolution") }}", status);

{{ validation_outputs(validation_mode_token | default("TOLERANT_INT"), validation_tolerance | default(1)) }}
    {% endif %}
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
