#include "{{ name }}_depthwise_conv.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}

// Context for buffer allocation
static cmsis_nn_context {{ name }}_ctx;

// Runtime scratch buffer (max upper bound; actual size queried at runtime)
// Buffer size calculated conservatively to handle MVE and DSP implementations
#define {{ name|upper }}_BUFFER_SIZE_MAX {{ buffer_size_max }}
static uint8_t {{ name }}_buffer[{{ name|upper }}_BUFFER_SIZE_MAX];

{% if kernel_fn == 'arm_depthwise_conv_wrapper_s8' and has_weight_sum %}
// Weight sum context for s8 depthwise wrappers
static cmsis_nn_context {{ name }}_weight_sum_ctx;
static int32_t {{ name }}_weight_sum_runtime[{{ output_dims.c }}];
{% endif %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_dims.n }} * {{ output_dims.h }} * {{ output_dims.w }} * {{ output_dims.c }})
static {{ output_dtype }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];

// Bias dimensions: bias shape is [1, 1, 1, C_OUT]
static const cmsis_nn_dims {{ name }}_bias_dims = {
    .n = 1, .h = 1,
    .w = 1, .c = {{ output_dims.c }}
};

int32_t {{ prefix }}_{{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    
    // Calculate required buffer size
    {% if float_kernel %}
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        &{{ name }}_dw_conv_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims{% if buffer_size_needs_layout %},
        {{ kernel_layout }}
        {% endif %}
    );
    {% else %}
    int32_t required_buffer_size = {{ kernel_get_buffer_size_fn }}(
        &{{ name }}_dw_conv_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims
    );
    {% endif %}

    if (required_buffer_size > {{ name|upper }}_BUFFER_SIZE_MAX) {
        return ARM_CMSIS_NN_ARG_ERROR;
    }

    // Initialize context buffer
    {% if force_no_scratch | default(false) %}
    {{ name }}_ctx.buf = NULL;
    {{ name }}_ctx.size = 0;
    {% else %}
    {{ name }}_ctx.buf = {{ name }}_buffer;
    {{ name }}_ctx.size = required_buffer_size;
    {% endif %}

    {% if kernel_fn == 'arm_depthwise_conv_wrapper_s8' and has_weight_sum %}
    // Compute weight sums at runtime when supported; fallback to precomputed values.
    arm_cmsis_nn_status weight_sum_status = arm_depthwise_convolve_weight_sum(
        {{ name }}_weight_sum_runtime,
        NULL,
        {{ name }}_weights,
        &{{ name }}_dw_conv_params,
        &{{ name }}_input_dims,
        &{{ name }}_filter_dims,
        &{{ name }}_output_dims,
        {{ name }}_dw_conv_params.input_offset,
        {% if has_biases %}
        {{ name }}_biases
        {% else %}
        NULL
        {% endif %}
    );
    if (weight_sum_status == ARM_CMSIS_NN_SUCCESS) {
        {{ name }}_weight_sum_ctx.buf = (uint8_t *){{ name }}_weight_sum_runtime;
    } else {
        {{ name }}_weight_sum_ctx.buf = (uint8_t *){{ name }}_weight_sum;
    }
    {{ name }}_weight_sum_ctx.size = {{ output_dims.c }} * sizeof(int32_t);
    {% endif %}

    // Call depthwise convolution kernel
    {% if float_kernel %}
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_ctx,
        &{{ name }}_dw_conv_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        {{ name }}_weights,
        &{{ name }}_bias_dims,
        {% if has_biases %}
        {{ name }}_biases,
        {% else %}
        NULL,
        {% endif %}
        &{{ name }}_output_dims,
        output{% if kernel_needs_layout %},
        {{ kernel_layout }}
        {% endif %}
    );
    {% else %}
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_ctx,
        {% if kernel_fn == 'arm_depthwise_conv_wrapper_s8' and has_weight_sum %}
        &{{ name }}_weight_sum_ctx,
        {% endif %}
        &{{ name }}_dw_conv_params,
        &{{ name }}_quant_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_filter_dims,
        {{ name }}_weights,
        &{{ name }}_bias_dims,
        {% if has_biases %}
        {% if kernel_fn == 'arm_depthwise_conv_wrapper_s16' %}
        (const int64_t*){{ name }}_biases,
        {% else %}
        {{ name }}_biases,
        {% endif %}
        {% else %}
        NULL,
        {% endif %}
        &{{ name }}_output_dims,
        output
    );
    {% endif %}

    return kernel_status;
}

int32_t {{ prefix }}_{{ name }}_test_case_run(void)
{
    int32_t status = {{ prefix }}_{{ name }}_run({{ name }}_input, {{ name }}_output);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Depthwise convolution") }}", status);

    int failures = 0;
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("TOLERANT_INT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
