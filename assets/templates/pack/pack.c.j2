#include "{{ name }}_pack.h"
#include "unity.h"
#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>

#ifdef USING_FVP_CORSTONE_300
extern void uart_init(void);
#endif

static inline void signal_eot(void)
{
    putchar(4);
    fflush(stdout);
}

void HardFault_Handler(void)
{
    printf("HardFault\r\n");
    signal_eot();
    while (1) { }
}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_size }})
static {{ output_dtype }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];

static void {{ name }}_pack_ref(const {{ input_dtype }} **inputs, {{ output_dtype }} *output)
{
    const int outer_size = {{ outer_size }};
    const int inner_size = {{ inner_size }};
    const int num_tensors = {{ num_tensors }};

    for (int outer = 0; outer < outer_size; ++outer) {
        for (int t = 0; t < num_tensors; ++t) {
            const {{ input_dtype }} *src = inputs[t] + outer * inner_size;
            {{ output_dtype }} *dst = output + (outer * num_tensors + t) * inner_size;
            for (int i = 0; i < inner_size; ++i) {
                dst[i] = ({{ output_dtype }})src[i];
            }
        }
    }
}

void setUp(void)
{
#ifdef USING_FVP_CORSTONE_300
    uart_init();
    setvbuf(stdout, NULL, _IONBF, 0);
#endif
}

void tearDown(void) {}

void test_{{ prefix }}_{{ name }}(void)
{
    const {{ input_dtype }} *inputs[] = {
        {{ name }}_input_1,
        {% for idx in range(2, num_tensors + 1) %}
        {{ name }}_input_{{ idx }},
        {% endfor %}
    };

    {{ name }}_pack_ref(inputs, {{ name }}_output);

    const int output_size = {{ name|upper }}_OUTPUT_SIZE;
    const {{ output_dtype }} *act = {{ name }}_output;
    const {{ output_dtype }} *exp = {{ name }}_expected_output;

    for (int i = 0; i < output_size; i++) {
        int act_val = (int)act[i];
        int exp_val = (int)exp[i];
        if (act_val != exp_val) {
            char msg[128];
            snprintf(msg, sizeof(msg), "Mismatch at index %d: expected %d, got %d", i, exp_val, act_val);
            TEST_ASSERT_EQUAL_MESSAGE(exp_val, act_val, msg);
        }
    }
}

int main(void)
{
    setUp();
    test_{{ prefix }}_{{ name }}();
    signal_eot();
    while (1) { }
}
