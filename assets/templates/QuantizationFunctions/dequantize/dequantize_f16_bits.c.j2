#include "{{ name }}_dequantize.h"
#include <string.h>
#include "arm_nnfunctions.h"
#include "Internal/arm_nn_vcvt_f16.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

#define {{ name|upper }}_OUTPUT_SIZE {{ input_size }}
{{ helia_guard_declare("float", name ~ "_output", name|upper ~ "_OUTPUT_SIZE") }}

/* The NaN rule this build compiled for {{ kernel_fn }}: the MVE vector conversion where the library
 * builds with float16, MVE float16 and no ARM_MATH_AUTOVECTORIZE, unless its assembler verdict needs
 * the scalar form (Internal/arm_nn_vcvt_f16.h); the scalar conversion's rule everywhere else. */
#if ARM_NN_ENABLE_F16 && defined(ARM_MATH_MVE_FLOAT16) && !defined(HELIA_CMSIS_NN_FLOAT_AUTOVECTORIZE) && \
    !defined(ARM_NN_VCVT_F16_SCALAR_FORM)
    #define {{ name|upper }}_EXPECTED_BITS {{ name }}_expected_vector_bits
    #define {{ name|upper }}_NAN_RULE "vector: default NaN"
#else
    #define {{ name|upper }}_EXPECTED_BITS {{ name }}_expected_scalar_bits
    #define {{ name|upper }}_NAN_RULE "scalar: quiet, sign and payload kept"
#endif

int32_t {{ name }}_test_case_run(void)
{
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    int32_t status = {{ kernel_fn }}({{ name }}_input, {{ name }}_output, {{ input_size }});
    int failures = 0;
    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("Dequantize") }} output", failures);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("Dequantize") }}", status);

    printf("HELIA_F16_NAN_RULE %s ({{ nan_count }} NaN inputs)\r\n", {{ name|upper }}_NAN_RULE);
    for (int32_t i = 0; i < {{ name|upper }}_OUTPUT_SIZE; ++i) {
        uint32_t got;
        memcpy(&got, &{{ name }}_output[i], sizeof(got));
        HELIA_VALIDATE_FLOAT_BITS(got, {{ name|upper }}_EXPECTED_BITS[i], 0x7f800000u, 0, i, 20, failures);
    }
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
