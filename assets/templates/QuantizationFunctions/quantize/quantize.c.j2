#include "{{ name }}_quantize.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}

#define {{ name|upper }}_OUTPUT_SIZE {{ input_size }}
static {{ output_dtype }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];

int32_t {{ prefix }}_{{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    {% if has_activation %}
    // TFLite applies activation in float space BEFORE quantization
    // To match TFLite behavior, we need to apply activation to float input first
    static float activated_input[{{ input_size }}];
    
    {% if activation_type == 'RELU' %}
    // ReLU: clamp negative values to zero
    for (int i = 0; i < {{ input_size }}; i++) {
        activated_input[i] = (input[i] < 0.0f) ? 0.0f : input[i];
    }
    {% elif activation_type == 'RELU6' %}
    // ReLU6: clamp to [0.0, 6.0]
    for (int i = 0; i < {{ input_size }}; i++) {
        float val = input[i];
        if (val < 0.0f) val = 0.0f;
        if (val > 6.0f) val = 6.0f;
        activated_input[i] = val;
    }
    {% endif %}
    
    // Call Quantize kernel on activated input
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        activated_input,
        output,
        {{ input_size }},        // size
        {{ zero_point }},        // zero_point
        {{ scale }}f             // scale (float)
    );
    {% else %}
    // No activation: quantize directly
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        input,
        output,
        {{ input_size }},        // size
        {{ zero_point }},        // zero_point
        {{ scale }}f             // scale (float)
    );
    {% endif %}
    
    if (kernel_status != ARM_CMSIS_NN_SUCCESS) {
        return kernel_status;
    }

    {% if has_activation and activation_kernel_fn %}
    // Coverage path: invoke legacy activation kernels on a scratch copy so
    // golden-checked output remains in the affine quantized domain.
    static {{ output_dtype }} activation_probe[{{ input_size }}];
    for (int i = 0; i < {{ input_size }}; i++) {
        activation_probe[i] = output[i];
    }
    {{ activation_kernel_fn }}(activation_probe, (uint16_t){{ input_size }});
    {% endif %}
    
    return ARM_CMSIS_NN_SUCCESS;
}

int32_t {{ prefix }}_{{ name }}_test_case_run(void)
{
    const arm_cmsis_nn_status expected = ARM_CMSIS_NN_SUCCESS;
    int32_t status = {{ prefix }}_{{ name }}_run({{ name }}_input, {{ name }}_output);
    if (status != expected) {
        printf("Quantize failed with status %d\r\n", status);
        printf("1 Failures\r\n");
        return 1;
    }

    // Verify outputs (allow 1-bit tolerance)
    int failures = 0;
    const int output_size = {{ name|upper }}_OUTPUT_SIZE;

    const {{ output_dtype }} *act = {{ name }}_output;
    const {{ output_dtype }} *exp = {{ name }}_expected_output;

    for (int i = 0; i < output_size; i++) {
        int act_val = (int)act[i];
        int exp_val = (int)exp[i];
        int diff = act_val - exp_val;
        if (diff < 0) diff = -diff;  // absolute difference
        if (diff > 1) {  // Allow tolerance of 1 bit difference
            failures++;
            if (failures <= 20) {
                printf("Mismatch[%d]: exp=%d got=%d (diff=%d)\r\n", i, exp_val, act_val, diff);
            }
        }
    }

    printf("%d Failures\r\n", failures);
    return failures;
}

