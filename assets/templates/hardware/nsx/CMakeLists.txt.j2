{# CMakeLists.txt -- top-level CMake for the hardware NSX app #}
# Generated by helia-core-tester. Do not edit.
cmake_minimum_required(VERSION 3.24)
project({{ app_name }} LANGUAGES C ASM)

set(NSX_BOARD "{{ board.nsx_board }}" CACHE STRING "Target board")
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
# Pinned before any BSP module loads.
set(NSX_AMBIQ_BSP_LIB_SUBDIR "{{ board.nsx_board }}" CACHE STRING "AmbiqSuite BSP lib subdir")

# Kernel switches; option() defaults cannot follow.
{% for name, value in cache_vars.items() %}
set({{ name }} "{{ value }}" CACHE STRING "helia-core-tester kernel option" FORCE)
{% endfor %}
# RTT channel 0; the module compiles these.
set(NSX_SEGGER_RTT_BUFFER_SIZE_UP {{ rtt_buffer_size_up }} CACHE STRING "RTT channel 0 up buffer bytes" FORCE)
set(NSX_SEGGER_RTT_BUFFER_SIZE_DOWN {{ rtt_buffer_size_down }} CACHE STRING "RTT channel 0 down buffer bytes" FORCE)

include(${CMAKE_CURRENT_LIST_DIR}/cmake/nsx/modules.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/cmake/nsx/nsx_app_bootstrap.cmake)

nsx_bootstrap_app(
    APP_ROOT "${CMAKE_CURRENT_LIST_DIR}"
    BOARD "${NSX_BOARD}"
    MODULES ${NSX_APP_MODULES}
)

# Sources live in the rendering checkout.
set(HCT_HARDWARE_DIR "{{ hardware_dir }}")
set(HCT_SCRIPTS_DIR "{{ scripts_dir }}")
# Synced or vendored kernels.
set(HCT_KERNEL_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/modules/{{ kernel_dir }}")
# pmu_armv8.h; nsx-cmsis-core lacks it.
set(HCT_CMSIS_CORE_INCLUDE "{{ cmsis_core_include }}")

find_package(Python3 COMPONENTS Interpreter REQUIRED)

# Weak refs keep every kernel linked.
set(HCT_SYMBOL_REFS_DIR "${CMAKE_BINARY_DIR}/hardware")
set(HCT_SYMBOL_REFS_INC "${HCT_SYMBOL_REFS_DIR}/kernel_symbol_refs.inc")
set(HCT_SYMBOL_REF_ARGS
    --cmsis-nn-root "${HCT_KERNEL_SOURCE_DIR}"
    --archive "$<TARGET_FILE:nsx_cmsis_nn>"
    --output "${HCT_SYMBOL_REFS_INC}")
{% if enable_f32 %}
list(APPEND HCT_SYMBOL_REF_ARGS --enable-f32)
{% endif %}
{% if enable_f16 %}
list(APPEND HCT_SYMBOL_REF_ARGS --enable-f16)
{% endif %}
add_custom_command(
    OUTPUT "${HCT_SYMBOL_REFS_INC}"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${HCT_SYMBOL_REFS_DIR}"
    COMMAND "${Python3_EXECUTABLE}" "${HCT_SCRIPTS_DIR}/generate_kernel_symbol_refs.py"
            ${HCT_SYMBOL_REF_ARGS}
    DEPENDS
        nsx_cmsis_nn
        "${HCT_SCRIPTS_DIR}/generate_kernel_symbol_refs.py"
        "${HCT_KERNEL_SOURCE_DIR}/Include/arm_nnfunctions.h"
        "${HCT_KERNEL_SOURCE_DIR}/Include/arm_nnfunctions_flt.h"
    VERBATIM)
add_custom_target(hct_kernel_symbol_refs DEPENDS "${HCT_SYMBOL_REFS_INC}")

add_executable({{ target }}
{% for name in sources %}
    "${HCT_HARDWARE_DIR}/{{ name }}"
{% endfor %}
)
set_target_properties({{ target }} PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/{{ image_dir }}")
add_dependencies({{ target }} hct_kernel_symbol_refs)
target_include_directories({{ target }} PRIVATE
    "${HCT_SYMBOL_REFS_DIR}"
    "${HCT_HARDWARE_DIR}"
    "${HCT_CMSIS_CORE_INCLUDE}")
target_compile_definitions({{ target }} PRIVATE
    HELIA_HARDWARE_BUILD
{% if not build_size_probe %}
    HCT_BENCHMARK_SERVER_BOARD_ID="{{ board.nsx_board }}"
    HCT_BENCHMARK_SERVER_TARGET_CPU="{{ board.cpu }}"
    HCT_SERVER_WORKSPACE_BYTES={{ board.workspace_bytes }}
    HCT_BENCHMARK_SERVER_BUILD_ID_PATCHED
{% endif %}
)
# Keep MVE out of the timed harness.
target_compile_options({{ target }} PRIVATE -Wno-cast-function-type -fno-tree-vectorize)
target_link_libraries({{ target }} PRIVATE
    nsx::board
    nsx::core
    nsx::cmsis_core
    nsx::cmsis_nn
    nsx::segger_rtt
{% if link_pmu %}
    nsx::pmu_armv8m
{% endif %}
)

nsx_finalize_app({{ target }})

{% if not build_size_probe %}
# Post-link image hash into the id slot.
# Runs after finalize's objcopy; before .elf copy.
add_custom_command(TARGET {{ target }} POST_BUILD
    COMMAND "${Python3_EXECUTABLE}" "${HCT_SCRIPTS_DIR}/patch_build_id.py"
            --elf "$<TARGET_FILE:{{ target }}>"
            --bin "$<TARGET_FILE_DIR:{{ target }}>/{{ target }}.bin"
            --output-txt "${CMAKE_BINARY_DIR}/{{ build_id_txt }}"
    COMMENT "Stamping {{ target }} build id"
    VERBATIM)
# NSX's flash recipe loads <build>/<target>.bin.
add_custom_command(TARGET {{ target }} POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
        "$<TARGET_FILE_DIR:{{ target }}>/{{ target }}.bin"
        "${CMAKE_BINARY_DIR}/{{ target }}.bin"
    VERBATIM)
{% endif %}
# NSX links .axf; host tooling reads .elf.
add_custom_command(TARGET {{ target }} POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
        "$<TARGET_FILE:{{ target }}>"
        "$<TARGET_FILE_DIR:{{ target }}>/{{ target }}.elf"
    VERBATIM)
