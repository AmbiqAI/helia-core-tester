#include "{{ name }}_resize_nearest_neighbor.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}

#define {{ name|upper }}_OUTPUT_SIZE ({{ output_size }})
static {{ output_dtype }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];
static int32_t {{ name }}_buffer[{{ buffer_size }}];

static cmsis_nn_context {{ name }}_ctx = {
    .buf = {{ name }}_buffer,
    .size = sizeof({{ name }}_buffer),
};

static cmsis_nn_resize_params {{ name }}_params = {
    .align_corners = {{ align_corners }},
    .half_pixel_centers = {{ half_pixel_centers }},
};

int32_t {{ prefix }}_{{ name }}_run(
    const {{ input_dtype }}* __restrict input,
    {{ output_dtype }}* __restrict output
) {
    arm_cmsis_nn_status kernel_status = {{ kernel_fn }}(
        &{{ name }}_ctx,
        &{{ name }}_params,
        &{{ name }}_input_dims,
        input,
        &{{ name }}_output_size_dims,
        {{ name }}_output_size_data,
        &{{ name }}_output_dims,
        output
    );
    return kernel_status;
}

int32_t {{ prefix }}_{{ name }}_test_case_run(void)
{
    int32_t status = {{ prefix }}_{{ name }}_run({{ name }}_input, {{ name }}_output);
    HELIA_VALIDATE_STATUS("{{ validation_label | default("ResizeNearestNeighbor") }}", status);

    int failures = 0;
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("EXACT_INT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(1) }},
        {{ validation_atol | default(0.01) }}f,
        {{ validation_rtol | default(0.001) }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
