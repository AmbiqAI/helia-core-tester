#include "{{ name }}_lstm_unidirectional.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

{{ helia_guard_declare(data_dtype, name ~ "_output", dst_size) }}
{{ helia_guard_declare(data_dtype, name ~ "_temp1", cell_state_size) }}
{{ helia_guard_declare(data_dtype, name ~ "_temp2", cell_state_size) }}
{# cell_state/hidden_state are explicitly zero-seeded once below and carried
   across chunk calls: guarded but never poisoned. #}
{{ helia_guard_declare(data_dtype, name ~ "_cell_state", cell_state_size) }}
{{ helia_guard_declare(data_dtype, name ~ "_hidden_state", cell_state_size) }}

/*
 * Streaming/stateful test case: replays the full sequence across
 * {{ chunk_lengths | length }} chunked calls, carrying hidden_state
 * between calls (batch_size == 1 only), and validates the concatenated
 * chunked output against the single-shot golden reference.
 *
 * Unlike GRU, LSTM's cell_state is also caller-owned state, not just
 * hidden_state: per arm_lstm_unidirectional_f32.c, the kernel only zeroes
 * cell_state itself when hidden_state == NULL (single-shot mode). In
 * streaming mode (hidden_state != NULL throughout, as here) cell_state is
 * treated as in/out and must be seeded to zero once by the caller and then
 * left alone across chunk boundaries -- it is NOT re-zeroed per chunk.
 */
static int32_t run_lstm_chunk(int32_t chunk_time_steps, int32_t input_offset, int32_t output_offset)
{
    HELIA_GUARD_ARM({{ name }}_temp1, true /* pure scratch: poison to catch read-before-write */);
    HELIA_GUARD_ARM({{ name }}_temp2, true /* pure scratch: poison to catch read-before-write */);

    const {{ lstm_params_type }} params = {
        .time_major = {{ time_major_literal }},
        .batch_size = {{ batch_size }},
        .time_steps = chunk_time_steps,
        .input_size = {{ input_size }},
        .hidden_size = {{ hidden_size }},
        .cell_clip = {{ cell_clip_literal }},
        .forget_gate = {
            .input_weights = {{ name }}_forget_gate_input_weights,
            .hidden_weights = {{ name }}_forget_gate_hidden_weights,
            .bias = {% if use_bias | default(true) %}{{ name }}_forget_gate_bias{% else %}NULL{% endif %},
            .activation_type = ARM_NN_FLT_ACT_SIGMOID,
        },
        .input_gate = {
            .input_weights = {{ name }}_input_gate_input_weights,
            .hidden_weights = {{ name }}_input_gate_hidden_weights,
            .bias = {% if use_bias | default(true) %}{{ name }}_input_gate_bias{% else %}NULL{% endif %},
            .activation_type = ARM_NN_FLT_ACT_SIGMOID,
        },
        .cell_gate = {
            .input_weights = {{ name }}_cell_gate_input_weights,
            .hidden_weights = {{ name }}_cell_gate_hidden_weights,
            .bias = {% if use_bias | default(true) %}{{ name }}_cell_gate_bias{% else %}NULL{% endif %},
            .activation_type = ARM_NN_FLT_ACT_TANH,
        },
        .output_gate = {
            .input_weights = {{ name }}_output_gate_input_weights,
            .hidden_weights = {{ name }}_output_gate_hidden_weights,
            .bias = {% if use_bias | default(true) %}{{ name }}_output_gate_bias{% else %}NULL{% endif %},
            .activation_type = ARM_NN_FLT_ACT_SIGMOID,
        },
    };
    {{ lstm_context_type }} buffers = {
        .temp1 = {{ name }}_temp1,
        .temp2 = {{ name }}_temp2,
        .cell_state = {{ name }}_cell_state,
        .hidden_state = {{ name }}_hidden_state,
    };

    return {{ kernel_fn }}(
        {{ name }}_input_tensor + input_offset,
        {{ name }}_output + output_offset,
        &params,
        &buffers);
}

int32_t {{ name }}_test_case_run(void)
{
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    HELIA_GUARD_ARM({{ name }}_cell_state, false /* zero-seeded below: don't poison */);
    HELIA_GUARD_ARM({{ name }}_hidden_state, false /* zero-seeded below: don't poison */);

    /* Fresh streaming state for this sequence: both hidden_state and
     * cell_state start at zero, matching the kernel's own single-shot
     * zero-init (see comment above) -- but seeded once here since the
     * kernel will not zero cell_state itself once hidden_state is non-NULL. */
    for (int32_t h = 0; h < {{ cell_state_size }}; h++)
    {
        {{ name }}_hidden_state[h] = ({{ data_dtype }})0;
        {{ name }}_cell_state[h] = ({{ data_dtype }})0;
    }

    int32_t status;
    int failures = 0;
{% for length in chunk_lengths %}
    status = run_lstm_chunk({{ length }}, {{ chunk_input_offsets[loop.index0] }}, {{ chunk_output_offsets[loop.index0] }});
    HELIA_VALIDATE_STATUS("{{ validation_label | default("LSTM") }} (chunk {{ loop.index0 }})", status);
    // temp1/temp2 are re-armed (re-poisoned) at the top of the next chunk's
    // run_lstm_chunk() call, which would erase any breach from *this* chunk
    // before a single post-loop check ever saw it -- so check them here,
    // once per chunk, immediately after each kernel call.
    HELIA_GUARD_CHECK({{ name }}_temp1, "{{ validation_label | default("LSTM") }} temp1 (chunk {{ loop.index0 }})", failures);
    HELIA_GUARD_CHECK({{ name }}_temp2, "{{ validation_label | default("LSTM") }} temp2 (chunk {{ loop.index0 }})", failures);
{% endfor %}

    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("LSTM") }} output", failures);
    HELIA_GUARD_CHECK({{ name }}_cell_state, "{{ validation_label | default("LSTM") }} cell_state", failures);
    HELIA_GUARD_CHECK({{ name }}_hidden_state, "{{ validation_label | default("LSTM") }} hidden_state", failures);
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("FLOAT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ dst_size }},
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(8) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
