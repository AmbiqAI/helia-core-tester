#include "{{ name }}_gru_unidirectional.h"
{% include "common/standalone/runtime_common.j2" %}

{# Declare only the buffers this fault mode actually passes to the kernel:
   a NULL-substituted buffer would otherwise be an unused static
   (-Wunused-variable), which becomes a hard error under -Werror. #}
{% if fault != "null_output" %}static {{ data_dtype }} {{ name }}_output[{{ dst_size }}];
{% endif %}{% if fault != "missing_temp1_prereset" %}static {{ data_dtype }} {{ name }}_temp1[{{ hidden_state_size }}];
{% endif %}{% if fault == "stateful_batch_gt1" %}static {{ data_dtype }} {{ name }}_hidden_state[{{ hidden_state_size }}];
{% endif %}

/*
 * Fault-injection test case: exercises an {{ kernel_fn }}
 * argument-validation branch. Fault mode: {{ fault }}.
 */
static int32_t run_gru(void)
{
{% if fault != "null_params" %}    const {{ gru_params_type }} params = {
        .time_major = {{ time_major_literal }},
        .batch_size = {% if fault == "zero_batch_size" %}0{% else %}{{ batch_size }}{% endif %},
        .time_steps = {% if fault == "negative_time_steps" %}-{{ time_steps }}{% else %}{{ time_steps }}{% endif %},
        .input_size = {% if fault == "negative_input_size" %}-{{ input_size }}{% else %}{{ input_size }}{% endif %},
        .hidden_size = {% if fault == "negative_hidden_size" %}-{{ hidden_size }}{% else %}{{ hidden_size }}{% endif %},
        .reset_after = {{ reset_after_literal }},
        .update_gate = {
            .input_weights = {{ name }}_update_gate_input_weights,
            .hidden_weights = {{ name }}_update_gate_hidden_weights,
            .input_bias = {{ name }}_update_gate_input_bias,
            .hidden_bias = {{ name }}_update_gate_hidden_bias,
        },
        .reset_gate = {
            .input_weights = {{ name }}_reset_gate_input_weights,
            .hidden_weights = {{ name }}_reset_gate_hidden_weights,
            .input_bias = {{ name }}_reset_gate_input_bias,
            .hidden_bias = {{ name }}_reset_gate_hidden_bias,
        },
        .candidate_gate = {
            .input_weights = {{ name }}_candidate_gate_input_weights,
            .hidden_weights = {{ name }}_candidate_gate_hidden_weights,
            .input_bias = {{ name }}_candidate_gate_input_bias,
            .hidden_bias = {{ name }}_candidate_gate_hidden_bias,
        },
    };
{% endif %}    {{ gru_context_type }} buffers = {
        .temp1 = {% if fault == "missing_temp1_prereset" %}NULL{% else %}{{ name }}_temp1{% endif %},
        .hidden_state = {% if fault == "stateful_batch_gt1" %}{{ name }}_hidden_state{% else %}NULL{% endif %},
    };

    const {{ data_dtype }} *input_arg = {% if fault == "null_input" %}NULL{% else %}{{ name }}_input_tensor{% endif %};
    {{ data_dtype }} *output_arg = {% if fault == "null_output" %}NULL{% else %}{{ name }}_output{% endif %};
    const {{ gru_params_type }} *params_arg = {% if fault == "null_params" %}NULL{% else %}&params{% endif %};

    return {{ kernel_fn }}(input_arg, output_arg, params_arg, &buffers);
}

int32_t {{ name }}_test_case_run(void)
{
    int32_t status = run_gru();
    HELIA_VALIDATE_EXPECTED_STATUS(
        "{{ validation_label | default("GRU") }}",
        status,
        {{ expected_status | default("ARM_CMSIS_NN_SUCCESS") }}
    );
    HELIA_VALIDATE_RETURN_FAILURES(0);
}

