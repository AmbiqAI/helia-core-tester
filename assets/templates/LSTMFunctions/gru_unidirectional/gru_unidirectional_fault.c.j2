#include "{{ name }}_gru_unidirectional.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

{# Declare only the buffers this fault mode actually passes to the kernel:
   a NULL-substituted buffer would otherwise be an unused static
   (-Wunused-variable), which becomes a hard error under -Werror. #}
{% set pass_output = fault != "null_output" %}
{% set pass_temp1 = fault not in ["missing_temp1_prereset", "null_buffers"] %}
{% set pass_hidden_state = fault == "stateful_batch_gt1" %}
{% if pass_output %}{{ helia_guard_declare(data_dtype, name ~ "_output", dst_size) }}
{% endif %}{% if pass_temp1 %}{{ helia_guard_declare(data_dtype, name ~ "_temp1", hidden_state_size) }}
{% endif %}{% if pass_hidden_state %}{{ helia_guard_declare(data_dtype, name ~ "_hidden_state", hidden_state_size) }}
{% endif %}

/*
 * Fault-injection test case: exercises an {{ kernel_fn }}
 * argument-validation branch. Fault mode: {{ fault }}.
 */
static int32_t run_gru(void)
{
{% if fault != "null_params" %}    const {{ gru_params_type }} params = {
        .time_major = {{ time_major_literal }},
        .batch_size = {% if fault == "zero_batch_size" %}0{% else %}{{ batch_size }}{% endif %},
        .time_steps = {% if fault == "negative_time_steps" %}-{{ time_steps }}{% else %}{{ time_steps }}{% endif %},
        .input_size = {% if fault == "negative_input_size" %}-{{ input_size }}{% else %}{{ input_size }}{% endif %},
        .hidden_size = {% if fault == "negative_hidden_size" %}-{{ hidden_size }}{% else %}{{ hidden_size }}{% endif %},
        .reset_after = {{ reset_after_literal }},
        .update_gate = {
            .input_weights = {{ name }}_update_gate_input_weights,
            .hidden_weights = {{ name }}_update_gate_hidden_weights,
            .input_bias = {% if use_bias | default(true) %}{{ name }}_update_gate_input_bias{% else %}NULL{% endif %},
            .hidden_bias = {% if use_bias | default(true) %}{{ name }}_update_gate_hidden_bias{% else %}NULL{% endif %},
        },
        .reset_gate = {
            .input_weights = {{ name }}_reset_gate_input_weights,
            .hidden_weights = {{ name }}_reset_gate_hidden_weights,
            .input_bias = {% if use_bias | default(true) %}{{ name }}_reset_gate_input_bias{% else %}NULL{% endif %},
            .hidden_bias = {% if use_bias | default(true) %}{{ name }}_reset_gate_hidden_bias{% else %}NULL{% endif %},
        },
        .candidate_gate = {
            .input_weights = {{ name }}_candidate_gate_input_weights,
            .hidden_weights = {{ name }}_candidate_gate_hidden_weights,
            .input_bias = {% if use_bias | default(true) %}{{ name }}_candidate_gate_input_bias{% else %}NULL{% endif %},
            .hidden_bias = {% if use_bias | default(true) %}{{ name }}_candidate_gate_hidden_bias{% else %}NULL{% endif %},
        },
    };
{% endif %}{% if fault != "null_buffers" %}    {{ gru_context_type }} buffers = {
        .temp1 = {% if fault == "missing_temp1_prereset" %}NULL{% else %}{{ name }}_temp1{% endif %},
        .hidden_state = {% if fault == "stateful_batch_gt1" %}{{ name }}_hidden_state{% else %}NULL{% endif %},
    };
{% endif %}
    const {{ data_dtype }} *input_arg = {% if fault == "null_input" %}NULL{% else %}{{ name }}_input_tensor{% endif %};
    {{ data_dtype }} *output_arg = {% if fault == "null_output" %}NULL{% else %}{{ name }}_output{% endif %};
    const {{ gru_params_type }} *params_arg = {% if fault == "null_params" %}NULL{% else %}&params{% endif %};
    {{ gru_context_type }} *buffers_arg = {% if fault == "null_buffers" %}NULL{% else %}&buffers{% endif %};

    return {{ kernel_fn }}(input_arg, output_arg, params_arg, buffers_arg);
}

int32_t {{ name }}_test_case_run(void)
{
{% if pass_output %}    HELIA_GUARD_ARM({{ name }}_output, true /* rejected call must not write it: poison */);
{% endif %}{% if pass_temp1 %}    HELIA_GUARD_ARM({{ name }}_temp1, true /* pure scratch: poison-safe */);
{% endif %}{% if pass_hidden_state %}    HELIA_GUARD_ARM({{ name }}_hidden_state, true /* rejected call must not write it: poison */);
{% endif %}    int32_t status = run_gru();
    int failures = 0;
{% if pass_output %}    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("GRU") }} output", failures);
{% endif %}{% if pass_temp1 %}    HELIA_GUARD_CHECK({{ name }}_temp1, "{{ validation_label | default("GRU") }} temp1", failures);
{% endif %}{% if pass_hidden_state %}    HELIA_GUARD_CHECK({{ name }}_hidden_state, "{{ validation_label | default("GRU") }} hidden_state", failures);
{% endif %}    HELIA_VALIDATE_EXPECTED_STATUS(
        "{{ validation_label | default("GRU") }}",
        status,
        {{ expected_status | default("ARM_CMSIS_NN_SUCCESS") }}
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
