#include "{{ name }}_gru_unidirectional.h"
{% include "common/standalone/runtime_common.j2" %}
{% from "common/standalone/runtime_common.j2" import helia_guard_declare %}

{{ helia_guard_declare(data_dtype, name ~ "_output", dst_size) }}
{{ helia_guard_declare(data_dtype, name ~ "_temp1", hidden_state_size) }}
{# hidden_state is explicitly zero-seeded once below and carried across
   chunk calls: guarded but never poisoned. #}
{{ helia_guard_declare(data_dtype, name ~ "_hidden_state", hidden_state_size) }}

/*
 * Streaming/stateful test case: replays the full sequence across
 * {{ chunk_lengths | length }} chunked calls, carrying hidden_state
 * between calls (batch_size == 1 only), and validates the concatenated
 * chunked output against the single-shot golden reference.
 */
static int32_t run_gru_chunk(int32_t chunk_time_steps, int32_t input_offset, int32_t output_offset)
{
    HELIA_GUARD_ARM({{ name }}_temp1, true /* pure scratch: poison to catch read-before-write */);

    const {{ gru_params_type }} params = {
        .time_major = {{ time_major_literal }},
        .batch_size = {{ batch_size }},
        .time_steps = chunk_time_steps,
        .input_size = {{ input_size }},
        .hidden_size = {{ hidden_size }},
        .reset_after = {{ reset_after_literal }},
        .update_gate = {
            .input_weights = {{ name }}_update_gate_input_weights,
            .hidden_weights = {{ name }}_update_gate_hidden_weights,
            .input_bias = {% if use_bias | default(true) %}{{ name }}_update_gate_input_bias{% else %}NULL{% endif %},
            .hidden_bias = {% if use_bias | default(true) %}{{ name }}_update_gate_hidden_bias{% else %}NULL{% endif %},
        },
        .reset_gate = {
            .input_weights = {{ name }}_reset_gate_input_weights,
            .hidden_weights = {{ name }}_reset_gate_hidden_weights,
            .input_bias = {% if use_bias | default(true) %}{{ name }}_reset_gate_input_bias{% else %}NULL{% endif %},
            .hidden_bias = {% if use_bias | default(true) %}{{ name }}_reset_gate_hidden_bias{% else %}NULL{% endif %},
        },
        .candidate_gate = {
            .input_weights = {{ name }}_candidate_gate_input_weights,
            .hidden_weights = {{ name }}_candidate_gate_hidden_weights,
            .input_bias = {% if use_bias | default(true) %}{{ name }}_candidate_gate_input_bias{% else %}NULL{% endif %},
            .hidden_bias = {% if use_bias | default(true) %}{{ name }}_candidate_gate_hidden_bias{% else %}NULL{% endif %},
        },
    };
    {{ gru_context_type }} buffers = {
        .temp1 = {{ name }}_temp1,
        .hidden_state = {{ name }}_hidden_state,
    };

    return {{ kernel_fn }}(
        {{ name }}_input_tensor + input_offset,
        {{ name }}_output + output_offset,
        &params,
        &buffers);
}

int32_t {{ name }}_test_case_run(void)
{
    HELIA_GUARD_ARM({{ name }}_output, false /* real output, not scratch: don't poison */);
    HELIA_GUARD_ARM({{ name }}_hidden_state, false /* zero-seeded below: don't poison */);

    /* Fresh streaming state for this sequence. */
    for (int32_t h = 0; h < {{ hidden_state_size }}; h++)
    {
        {{ name }}_hidden_state[h] = ({{ data_dtype }})0;
    }

    int32_t status;
    int failures = 0;
{% for length in chunk_lengths %}
    status = run_gru_chunk({{ length }}, {{ chunk_input_offsets[loop.index0] }}, {{ chunk_output_offsets[loop.index0] }});
    HELIA_VALIDATE_STATUS("{{ validation_label | default("GRU") }} (chunk {{ loop.index0 }})", status);
    // temp1 is re-armed (re-poisoned) at the top of the next chunk's
    // run_gru_chunk() call, which would erase any breach from *this* chunk
    // before a single post-loop check ever saw it -- so check it here, once
    // per chunk, immediately after each kernel call.
    HELIA_GUARD_CHECK({{ name }}_temp1, "{{ validation_label | default("GRU") }} temp1 (chunk {{ loop.index0 }})", failures);
{% endfor %}

    HELIA_GUARD_CHECK({{ name }}_output, "{{ validation_label | default("GRU") }} output", failures);
    HELIA_GUARD_CHECK({{ name }}_hidden_state, "{{ validation_label | default("GRU") }} hidden_state", failures);
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("FLOAT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ dst_size }},
        {{ validation_tolerance | default(1) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(8) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

