#include "{{ name }}_mirror_pad.h"
#include "arm_nnfunctions.h"
{% include "common/standalone/runtime_common.j2" %}

#define {{ name|upper }}_OUTPUT_SIZE {{ output_size }}
static {{ c_type }} {{ name }}_output[{{ name|upper }}_OUTPUT_SIZE];

int32_t {{ name }}_test_case_run(void)
{
    arm_cmsis_nn_status status = {{ kernel_fn }}(
        {{ name }}_input,
        &{{ name }}_params,
        {{ name }}_output
    );
    HELIA_VALIDATE_STATUS("MirrorPad", status);

    int failures = 0;
    HELIA_VALIDATE_OUTPUTS(
        {{ validation_mode_token | default("TOLERANT_INT") }},
        {{ name }}_output,
        {{ name }}_expected_output,
        {{ name|upper }}_OUTPUT_SIZE,
        {{ validation_tolerance | default(0) }},
        {{ validation_atol }}f,
        {{ validation_rtol }}f,
        {{ validation_report_limit | default(20) }},
        failures
    );
    HELIA_VALIDATE_RETURN_FAILURES(failures);
}

{% include "common/standalone/main.j2" %}
