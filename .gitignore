# Build artifacts
build*/
CMakeCache.txt
CMakeFiles/
*.cmake
!CMakeLists.txt
# App-owned NSX hardware-build glue (not vendor/generated -- see
# cmake/nsx/nsx_app_bootstrap.cmake's own header comment). nsx_toolchain_flags
# is whitelisted too: nsx_app_bootstrap.cmake include()s it unconditionally at
# file scope, so a clone without it cannot configure HELIA_HARDWARE_BUILD=ON at
# all. Everything else under cmake/nsx/ (toolchains/, the nsx_soc_facts.cmake and
# socs symlinks into the fetched SDK) stays ignored: machine-specific or vendored.
!cmake/nsx/nsx_app_bootstrap.cmake
!cmake/nsx/nsx_helpers.cmake
!cmake/nsx/nsx_toolchain_flags.cmake
*.a
*.o
*.elf
*.bin

# Generated files
artifacts/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.test
.env.production

# Dependencies (downloaded, not tracked)
artifacts/downloads/*

# Submodules (tracked separately)
modules/*
!modules/README.md

# Generated symlinks into the fetched nsx-ambiq-sdk checkout (see
# setup_dependencies.py's _ensure_nsx_sdk_symlinks()) -- regenerated by the
# dependency pipeline, never tracked.
boards/
cmake/socs

# Temporary files
*.tmp
*.bak
*.backup
*.orig
